0xEE001A10  // [ 3]
0xE3A00000  // [ 4]
0xE5902000  // [ 5]
0xE5903004  // [ 6]
0xEE012A10  // [ 7]
0xEE023A10  // [ 8]
0xE3A04041  // [ 9]
0xEE034A10  // [10]
0xE1A06103  // [11]
0xE2866010  // [12]
0xEE195A10  // [13]
0xE1550006  // [14]
0x1AFFFFFC  // [15]
0xEAFFFFFE  // [16]
0xEAFFFFFE  // [17]
