# One spot: reads GPU[X1_BASE + ot*4 + pair..+1] per bank (2 BF16 per bank).
# $pair ∈ {0, 2} selects which pair of sample lanes to inspect.
sub probe_x1_spot {
    my ($ot, $pair) = @_;
    my $gpu_src = $ANN_HW_GPU_X1_BASE + $ot * 4 + $pair;
    my @tx = run_pack_probe($gpu_src);
    # Same bank→TX mapping as probe_w
    my @got = ($tx[1] & 0xFFFF, ($tx[1] >> 16) & 0xFFFF,
               $tx[0] & 0xFFFF, ($tx[0] >> 16) & 0xFFFF,
               $tx[3] & 0xFFFF, ($tx[3] >> 16) & 0xFFFF,
               $tx[2] & 0xFFFF, ($tx[2] >> 16) & 0xFFFF);
    my @exp;
    for my $bank (0..3) {
        my $neuron = $ot * 4 + $bank;
        push @exp, $ann_ref_l1_act[$neuron * 4 + $pair],
                   $ann_ref_l1_act[$neuron * 4 + $pair + 1];
    }
    my $all_ok = 1;
    for my $i (0..7) { $all_ok = 0 if $got[$i] != $exp[$i]; }
    my $ok = $all_ok ? "[PASS]" : "[FAIL]";
    printf("  %s ot=%-2d  neurons %2d..%-2d  samples %d,%d   GPU[X1+%d..%d]\n",
        $ok, $ot, $ot*4, $ot*4+3, $pair, $pair+1, $ot*4+$pair, $ot*4+$pair+1);
    for my $bank (0..3) {
        my $g0 = $got[$bank*2];   my $g1 = $got[$bank*2+1];
        my $e0 = $exp[$bank*2];   my $e1 = $exp[$bank*2+1];
        my $mark = ($g0 == $e0 && $g1 == $e1) ? "   " : " ! ";
        printf("      %s bank%d (neuron %-2d)  got %04X %04X  exp %04X %04X  (%.4g %.4g vs %.4g %.4g)\n",
            $mark, $bank, $ot*4+$bank, $g0, $g1, $e0, $e1,
            bf16_to_f($g0), bf16_to_f($g1),
            bf16_to_f($e0), bf16_to_f($e1));
    }
    if ($all_ok) { $pass++ } else { $fail++ }
}

sub ann_probe_x1 {
    banner("T_PROBE_X1: L1 activations in GPU DMEM vs IP RTL reference");
    print "  Prerequisite: `sw/model_test load` then `sw/model_test run` has\n";
    print "  just completed (L1 activations live in GPU DMEM at X1_BASE..+95;\n";
    print "  BRAM persists across the hard_reset done by each pack_probe).\n\n";

    printf("  [REF] using %d hardcoded BF16 L1 activations (IP RTL dump)\n\n",
        scalar @ann_ref_l1_act);

    # Spot-check tiles across L1's 24 output chunks (ot ∈ 0..23, 96 neurons).
    probe_x1_spot(0,  0);    # tile 0    samples 0,1
    probe_x1_spot(0,  2);    # tile 0    samples 2,3
    probe_x1_spot(6,  0);    # tile 6    samples 0,1
    probe_x1_spot(12, 0);    # tile 12   samples 0,1
    probe_x1_spot(12, 2);    # tile 12   samples 2,3
    probe_x1_spot(18, 0);    # tile 18   samples 0,1
    probe_x1_spot(23, 0);    # tile 23   samples 0,1
    probe_x1_spot(23, 2);    # tile 23   samples 2,3

    print "\n  [NOTE] 8 spots × 4 banks × 2 samples = 64 BF16 values checked.\n";
    print "         PASS = L1 bit-exact with IP RTL reference → drift starts at L2/L3.\n";
    print "         FAIL = MAC-with-real-data diverges or scheduler state bug.\n";
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_X0: input data in GPU DMEM after sched_prog's D_UNPACK
#
#  Closes the last remaining upload-side blind spot: does the 80-DW
#  input block at CPU[INPUT_CPU_BASE..] actually land bit-correctly in
#  GPU[X0_BASE..] across all 4 banks after the scheduler's first
#  D_UNPACK?  probe_l verifies the CPU side; probe_k verifies D_UNPACK
#  with uniform data; probe_w verifies D_UNPACK of weights via the
#  copy_prog path (xfer_len=1020).  But sched_prog's input D_UNPACK
#  uses xfer_len=20 and varied bank-striped data — never directly
#  checked post-transfer.
#
#  Expected layout per bank b: GPU[X0_BASE + j] for j = 0..39 holds
#  input_bf16(feat, sample), where feat = (j/4)*4 + b and sample = j%4.
#  (Bank b owns features {b, b+4, b+8, …, b+36}, each across 4 samples.)
# ══════════════════════════════════════════════════════════════
sub expected_x0_bf16 {
    my ($bank, $gpu_off) = @_;
    my $addr_in_cpu_dw = $gpu_off;                 # lo for even j, hi for odd j
    my $feat   = int($addr_in_cpu_dw / 4) * 4 + $bank;
    my $sample = $addr_in_cpu_dw % 4;
    return input_bf16($feat, $sample);
}

# Reads GPU[X0_BASE + gpu_off..+1] per bank via D_PACK xfer_len=1/bank.
sub probe_x0_spot {
    my ($gpu_off) = @_;
    my $gpu_src = $ANN_HW_GPU_X0_BASE + $gpu_off;
    my @tx = run_pack_probe($gpu_src);
    my @got = ($tx[1] & 0xFFFF, ($tx[1] >> 16) & 0xFFFF,
               $tx[0] & 0xFFFF, ($tx[0] >> 16) & 0xFFFF,
               $tx[3] & 0xFFFF, ($tx[3] >> 16) & 0xFFFF,
               $tx[2] & 0xFFFF, ($tx[2] >> 16) & 0xFFFF);
    my @exp;
    for my $bank (0..3) {
        push @exp, expected_x0_bf16($bank, $gpu_off),
                   expected_x0_bf16($bank, $gpu_off + 1);
    }
    my $all_ok = 1;
    for my $i (0..7) { $all_ok = 0 if $got[$i] != $exp[$i]; }
    my $ok = $all_ok ? "[PASS]" : "[FAIL]";
    printf("  %s GPU[X0+%2d..%2d]\n", $ok, $gpu_off, $gpu_off + 1);
    for my $bank (0..3) {
        my $g0 = $got[$bank*2];   my $g1 = $got[$bank*2+1];
        my $e0 = $exp[$bank*2];   my $e1 = $exp[$bank*2+1];
        my $feat0   = int($gpu_off / 4) * 4 + $bank;
        my $sample0 = $gpu_off % 4;
        my $feat1   = int(($gpu_off + 1) / 4) * 4 + $bank;
        my $sample1 = ($gpu_off + 1) % 4;
        my $mark = ($g0 == $e0 && $g1 == $e1) ? "   " : " ! ";
        printf("      %s bank%d  (feat=%-2d,s=%d | feat=%-2d,s=%d)  got %04X %04X  exp %04X %04X  (%.3g %.3g vs %.3g %.3g)\n",
            $mark, $bank, $feat0, $sample0, $feat1, $sample1,
            $g0, $g1, $e0, $e1,
            bf16_to_f($g0), bf16_to_f($g1),
            bf16_to_f($e0), bf16_to_f($e1));
    }
    if ($all_ok) { $pass++ } else { $fail++ }
}

sub ann_probe_x0 {
    banner("T_PROBE_X0: input data in GPU DMEM after sched_prog's D_UNPACK");
    print "  Prerequisite: `sw/model_test load` + `run` has just completed\n";
    print "  (sched_prog has done its first D_UNPACK, GPU[X0_BASE..+39] per\n";
    print "  bank holds the striped input data; BRAM persists across reset).\n\n";

    # 10 spots covering every feature (40 feats / 4 feats-per-DW-row = 10).
    # Each spot reads 2 BF16 per bank; so we hit both sample pairs (0,1) and
    # (2,3) for all 10 "feature groups" in each bank.
    probe_x0_spot(0);    # feat b,    samples 0,1
    probe_x0_spot(2);    # feat b,    samples 2,3
    probe_x0_spot(4);    # feat b+4,  samples 0,1
    probe_x0_spot(6);    # feat b+4,  samples 2,3
    probe_x0_spot(16);   # feat b+16, samples 0,1
    probe_x0_spot(18);   # feat b+16, samples 2,3
    probe_x0_spot(20);   # feat b+20, samples 0,1
    probe_x0_spot(24);   # feat b+24, samples 0,1
    probe_x0_spot(36);   # feat b+36, samples 0,1
    probe_x0_spot(38);   # feat b+36, samples 2,3

    print "\n  [NOTE] 10 spots × 4 banks × 2 BF16 = 80 values checked (full\n";
    print "         coverage of the 40-BF16 input region per bank via 2-pair\n";
    print "         samples at 10 of 10 feature-group offsets).\n";
    print "         PASS on all ⇒ inputs reach GPU DMEM bit-exact.  Drift\n";
    print "         must then come from a region of weights we didn't sample,\n";
    print "         or from scheduler state not captured by probe_l.\n";
    print "         FAIL ⇒ sched_prog's D_UNPACK of X0 corrupts the data,\n";
    print "         and every L1 MAC downstream sees wrong inputs.\n";
}

# BF16 (bits 0..15) → decimal float. Returns Perl float (double internally).
sub bf16_to_f {
    my ($b) = @_;
    $b &= 0xFFFF;
    my $sign = ($b >> 15) & 1;
    my $exp  = ($b >> 7)  & 0xFF;
    my $frac = $b & 0x7F;
    return 0.0 if $exp == 0 && $frac == 0;
    if ($exp == 0xFF) { return $frac ? "NaN" : ($sign ? "-Inf" : "+Inf"); }
    my $mant = 1.0 + $frac / 128.0;
    my $val  = $mant * (2 ** ($exp - 127));
    return $sign ? -$val : $val;
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_WA: exhaustive weight scan for a single L1 tile
#
#  probe_w sampled 2 BF16 per tile at a few spots (~72 of ~8000 L1
#  weights total).  probe_wa scans ALL 40 weights per bank × 4 banks
#  (160 values) for ONE chosen L1 tile, exposing any per-row weight
#  corruption that probe_w's sparse sampling missed.
#
#  Defaults to ot=0 because probe_x1 showed neuron 0 drifting from
#  sim — bank 0's weights at GPU[W1_BASE+0..+39] are the prime
#  suspect.  Pass a different ot via the second CLI arg.
# ══════════════════════════════════════════════════════════════
sub ann_probe_wa {
    my ($ot) = @_;
    $ot = 0 unless defined $ot;
    banner(sprintf("T_PROBE_WA: exhaustive L1 weight scan for tile ot=%d", $ot));
    print "  Reads all 40 BF16/bank at GPU[W1_BASE + ot*40 ..+39] via D_PACK\n";
    print "  and compares each bank's value to pack_l1()'s host image.\n";
    print "  Any FAIL pinpoints a weight slot that didn't upload correctly.\n\n";

    ann_build_host();

    my $base = $ANN_HW_GPU_W1_BASE + $ot * 40;
    for (my $k_pair = 0; $k_pair < 20; $k_pair++) {
        my $col_start = $k_pair * 2;
        probe_weights_spot($base + $col_start,
            sprintf("ot=%-2d K[%2d..%-2d]", $ot, $col_start, $col_start + 1));
    }

    printf("\n  [NOTE] scanned %d BF16 weights in tile ot=%d (40/bank × 4 banks).\n",
        160, $ot);
    print "         PASS on all  ⇒ L1 weights for this tile are bit-exact.\n";
    print "         FAIL anywhere ⇒ copy_prog upload corrupts these specific slots\n";
    print "                        (run `load` fresh, then re-run probe_wa to see\n";
    print "                        if the corruption is persistent or transient).\n";
}

# Pretty-print 4 BF16 classes inside one packet (one 64b DW pair HI,LO).
sub decode_pkt {
    my ($hi, $lo) = @_;
    # 4 BF16 in one DW, little-endian: {c3, c2, c1, c0} stored as HI=(c3,c2), LO=(c1,c0)
    my @c = (
        $lo        & 0xFFFF,
        ($lo >> 16) & 0xFFFF,
        $hi        & 0xFFFF,
        ($hi >> 16) & 0xFFFF,
    );
    my @f = map { bf16_to_f($_) } @c;
    return (\@c, \@f);
}

sub class_name {
    my ($idx) = @_;
    return defined $ANN_CLASS_NAMES[$idx] ? $ANN_CLASS_NAMES[$idx] : sprintf("class%d", $idx);
}

sub class_argmax {
    my ($dec) = @_;
    my $best = 0;
    for my $k (1..3) {
        $best = $k if !ref($dec->[$k]) && $dec->[$k] > $dec->[$best];
    }
    return $best;
}

sub print_class_definitions {
    print "\nANN class definitions:\n";
    for my $i (0..$#ANN_CLASS_NAMES) {
        printf("  %d = %-10s  %s\n", $i, $ANN_CLASS_NAMES[$i], $ANN_CLASS_DESC[$i]);
    }
    print "\nInput preprocessing used by class-demo mode:\n";
    print "  raw 111 numeric CSV features\n";
    print "  + 14 COT ratios and 6 type_id ratios (131 total)\n";
    print "  + StandardScaler mean/std from scaler_mean.npy/scaler_std.npy\n";
    print "  + top-40 feature select by feat_idx.npy, then BF16 truncation\n";
}

# Read TX[2..3] by firing a second READBACK+SEND_PKT packet over words [804..807]
# of CPU DMEM (where pkt2, pkt3 live after the scheduler's post-process).  The
# snoop only captures 2 DWs per send, so we split the readback: first run
# already captured pkt0/pkt1; this helper captures pkt2/pkt3.
sub capture_tail_packets {
    ic();
    my @c;
    @c = cw(4, $ANN_HW_READBACK_CPU_BASE + 4, 2, 0); iw($c[0], $c[1], 0x20);
    @c = cw(5, 0, 0, 0);                               iw($c[0], $c[1], 0);
    id();
    if (pt(200, 50)) {
        return cr();    # (hi2, lo2, hi3, lo3)
    } else {
        print "  [WARN] tail-readback timed out; pkt2/pkt3 unavailable\n";
        return (0,0,0,0);
    }
}

sub verify_tx {
    my ($done, @tx) = @_;
    my @exp = (
        0xC1DBC1CD, 0x415EC0E8,    # pkt 0
        0xC074406F, 0xC21F415D,    # pkt 1
        0xC31EC33C, 0xC28D4397,    # pkt 2
        0xC315C327, 0xBF0A437A,    # pkt 3
    );
    if (!$done) { print "  [FAIL] no TX (timeout)\n"; $fail++; return }

    phase("Full TX capture (snoop catches 2 DWs; firing a second RB for pkt2/3)");
    my @tx_tail = capture_tail_packets();

    # Assemble full TX: pkt0..3 as (HI, LO) pairs
    my @got = (
        $tx[0], $tx[1],           # pkt 0 (from main snoop)
        $tx[2], $tx[3],           # pkt 1 (from main snoop)
        $tx_tail[0], $tx_tail[1], # pkt 2 (from tail snoop)
        $tx_tail[2], $tx_tail[3], # pkt 3 (from tail snoop)
    );

    # ── Decode + table ──
    print "\n  ┌───────┬──────────────── got ────────────────────┬──────────────── exp ────────────────────┬──── Δ (% per class) ────┐\n";
    print "  │  pkt  │ c0(hex)  c0(dec)  c1(hex)  c1(dec)  …   │ c0(hex)  c0(dec)  c1(hex)  c1(dec)  …   │  c0    c1    c2    c3   │\n";
    print "  ├───────┼──────────────────────────────────────────┼──────────────────────────────────────────┼─────────────────────────┤\n";
    my $packet_fail = 0;
    my $biggest_err = 0;
    for my $i (0..3) {
        my $gh = $got[$i*2];     my $gl = $got[$i*2 + 1];
        my $eh = $exp[$i*2];     my $el = $exp[$i*2 + 1];
        my ($g_hex, $g_dec) = decode_pkt($gh, $gl);
        my ($e_hex, $e_dec) = decode_pkt($eh, $el);

        my @dpc;   # Δ % per class
        for my $k (0..3) {
            my $e = $e_dec->[$k];
            my $g = $g_dec->[$k];
            if (!ref($e) && !ref($g) && abs($e) > 1e-6) {
                my $err_pct = 100 * ($g - $e) / abs($e);
                push @dpc, sprintf("%+6.1f%%", $err_pct);
                # Only track "biggest error" for classes with |exp| ≥ 1.0 —
                # values near zero produce huge percent swings on tiny
                # absolute deltas which isn't meaningful.
                if (abs($e) >= 1.0) {
                    my $abs_err_pct = abs($err_pct);
                    $biggest_err = $abs_err_pct if $abs_err_pct > $biggest_err;
                }
            } else {
                push @dpc, "  NaN ";
            }
        }

        my $exact = ($gh == $eh) && ($gl == $el);
        my $tag   = $exact ? "PASS" : "FAIL";
        $packet_fail++ unless $exact;

        printf("  │%s %d │ %04X %+7.2f  %04X %+7.2f  %04X %+7.2f  %04X %+7.2f │ %04X %+7.2f  %04X %+7.2f  %04X %+7.2f  %04X %+7.2f │ %s %s %s %s │\n",
            $tag, $i,
            $g_hex->[0], $g_dec->[0], $g_hex->[1], $g_dec->[1], $g_hex->[2], $g_dec->[2], $g_hex->[3], $g_dec->[3],
            $e_hex->[0], $e_dec->[0], $e_hex->[1], $e_dec->[1], $e_hex->[2], $e_dec->[2], $e_hex->[3], $e_dec->[3],
            $dpc[0], $dpc[1], $dpc[2], $dpc[3]);
    }
    print "  └───────┴──────────────────────────────────────────┴──────────────────────────────────────────┴─────────────────────────┘\n";

    # ── Argmax classification summary (class-level accuracy) ──
    my $argmax_agree = 0;
    my @class_rows;
    for my $i (0..3) {
        my $gh = $got[$i*2];     my $gl = $got[$i*2 + 1];
        my $eh = $exp[$i*2];     my $el = $exp[$i*2 + 1];
        my (undef, $g_dec) = decode_pkt($gh, $gl);
        my (undef, $e_dec) = decode_pkt($eh, $el);
        my $g_argmax = 0; my $e_argmax = 0;
        for my $k (1..3) {
            $g_argmax = $k if !ref($g_dec->[$k]) && $g_dec->[$k] > $g_dec->[$g_argmax];
            $e_argmax = $k if !ref($e_dec->[$k]) && $e_dec->[$k] > $e_dec->[$e_argmax];
        }
        my $agree = $g_argmax == $e_argmax;
        $argmax_agree++ if $agree;
        push @class_rows, sprintf("    pkt%d: got class %d (%.1f)  ·  exp class %d (%.1f)  %s",
            $i, $g_argmax, $g_dec->[$g_argmax], $e_argmax, $e_dec->[$e_argmax],
            $agree ? "[\xe2\x9c\x93]" : "[\xe2\x9c\x97]");
    }
    printf("\n  Argmax (classification accuracy %d/4 ≡ %d%%):\n",
        $argmax_agree, $argmax_agree * 25);
    print "$_\n" for @class_rows;

    # ── Mean |err| for classes with |exp| ≥ 1.0 (ignore near-zero noise) ──
    my $err_sum = 0; my $err_cnt = 0;
    for my $i (0..3) {
        my (undef, $g_dec) = decode_pkt($got[$i*2], $got[$i*2+1]);
        my (undef, $e_dec) = decode_pkt($exp[$i*2], $exp[$i*2+1]);
        for my $k (0..3) {
            my ($g, $e) = ($g_dec->[$k], $e_dec->[$k]);
            next if ref($g) || ref($e) || abs($e) < 1.0;
            $err_sum += abs(100 * ($g - $e) / abs($e));
            $err_cnt++;
        }
    }
    my $mean_err = $err_cnt ? $err_sum / $err_cnt : 0;

    # ── Score: count exact bit-match as pass ──
    for my $i (0..3) {
        my $gh = $got[$i*2];     my $gl = $got[$i*2 + 1];
        my $eh = $exp[$i*2];     my $el = $exp[$i*2 + 1];
        if ($gh == $eh && $gl == $el) { $pass++ } else { $fail++ }
    }

    if ($packet_fail) {
        printf("\n  [DIAG] bit-exact: %d/4 FAIL  ·  argmax: %d/4 %s  ·  mean |err| = %.1f%%  ·  max |err| = %.1f%% (|exp|≥1.0)\n",
            $packet_fail, $argmax_agree,
            $argmax_agree == 4 ? "PASS" : "FAIL",
            $mean_err, $biggest_err);

        if ($argmax_agree == 4 && $biggest_err < 25) {
            print "         ▸ Classification is CORRECT — the model works.  Numerical drift\n";
            print "           is uniform (~10-15%% multiplicative bias), matching a single\n";
            print "           BF16 arithmetic op in the bitfile rounding differently from\n";
            print "           the IP RTL reference.  Run `sw/model_test probe` next to\n";
            print "           isolate MAC vs K-accumulator.\n";
        } elsif ($argmax_agree < 4 && $biggest_err < 25) {
            print "         ▸ Classification drifted — numerical error large enough to\n";
            print "           flip decision boundaries.  Likely same synth-vs-sim BF16\n";
            print "           divergence from the IP RTL reference.\n";
        } elsif ($biggest_err >= 25) {
            print "         ▸ Magnitudes are far off (>25%%).  Suggests a data-path\n";
            print "           or layout issue (weights landing at wrong GPU offsets,\n";
            print "           sched records misencoded).  Run `sw/model_test diag`.\n";
        }
    }
}

sub verify_tx_classes {
    my ($done, @tx) = @_;
    if (!$done) { print "  [FAIL] no TX (timeout)\n"; $fail++; return }

    phase("Full TX capture for class-demo packets");
    my @tx_tail = capture_tail_packets();
    my @got = (
        $tx[0], $tx[1],
        $tx[2], $tx[3],
        $tx_tail[0], $tx_tail[1],
        $tx_tail[2], $tx_tail[3],
    );

    print_class_definitions();
    print "\n  Class-demo prediction table:\n";
    print "  sample  expected        got             logits[c0..c3]                         source\n";
    print "  ------  --------------  --------------  ------------------------------------  ------------------------------\n";

    my $agree = 0;
    for my $i (0..3) {
        my ($g_hex, $g_dec) = decode_pkt($got[$i*2], $got[$i*2 + 1]);
        my $g_argmax = class_argmax($g_dec);
        my $exp = $CLASS_DEMO_EXPECT[$i];
        my $ok = ($g_argmax == $exp);
        $agree++ if $ok;
        $ok ? $pass++ : $fail++;

        printf("  %-6d  %d:%-11s  %d:%-11s  %04X/%+6.2f %04X/%+6.2f %04X/%+6.2f %04X/%+6.2f  %s %s\n",
            $i,
            $exp, class_name($exp),
            $g_argmax, class_name($g_argmax),
            $g_hex->[0], $g_dec->[0],
            $g_hex->[1], $g_dec->[1],
            $g_hex->[2], $g_dec->[2],
            $g_hex->[3], $g_dec->[3],
            $CLASS_DEMO_SOURCE[$i],
            $ok ? "[PASS]" : "[FAIL]");
    }
    printf("\n  Class-demo accuracy: %d/4 (%d%%)\n", $agree, $agree * 25);
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE: minimal single-tile WMMA with hand-computable answer
#
#  Isolates the GPU FPU/tensor-core arithmetic from the full ANN flow.
#  If this probe's result drifts, the MAC core itself is synthesising
#  differently from what iverilog simulates — rebuild the bitfile.
#  If the probe passes but the full run is close-but-wrong, the issue
#  is in the K-accumulation over many MACs (fusion, accumulator width).
#
#  Compute (per bank): D = A · B + C
#    A = 4x4 of BF16 1.0 (0x3F80)
#    B = 4x4 of BF16 1.0 (0x3F80)
#    C = 4x4 of BF16 0.0 (0x0000)
#  Answer: D[i,j] = sum_{k=0..3} 1.0 · 1.0 + 0.0 = 4.0 = 0x4080 exactly
#  (no rounding, 4 ULPs fit in BF16 mantissa).
# ══════════════════════════════════════════════════════════════

# Internal helper — a single parameterised WMMA probe.
# Returns (TX[0] HI, TX[0] LO, TX[1] HI, TX[1] LO) captured from the snoop.
# $a_words, $b_words, $c_words are each arrayrefs of 4 BF16 u16 values.
sub run_probe_tile {
    my ($label, $a, $b, $c) = @_;
    hard_reset();

    # ── GPU program: A @ GPU[0..3], B @ GPU[4..7], C @ GPU[8..11],
    #    MMA, then STORE D → GPU[32..35].
    my @gp;
    push @gp, enc_movi_dt(0, 0, 0);
    push @gp, enc_wmma_load(0, 4, 0, 0);
    push @gp, enc_movi_dt(0, 0, 4);
    push @gp, enc_wmma_load(1, 8, 0, 0);
    push @gp, enc_movi_dt(0, 0, 8);
    push @gp, enc_wmma_load(2, 12, 0, 0);
    push @gp, enc_wmma_mma(12, 4, 8, 12);
    push @gp, enc_movi_dt(0, 0, 32);
    push @gp, enc_wmma_store(12, 0, 0);
    push @gp, (($OP_RET & 0x1F) << 27);
    push @gp, 0 while @gp % 2;

    # ── ARM (v2.0: CR10 TID gate, then D_IMEM + D_UNPACK + launch + D_PACK) ──
    my @arm;
    push @arm, arm_mrc(11, 10);
    push @arm, arm_cmp_imm(11, 0);
    push @arm, 0;
    push @arm, arm_mov_imm(0, 0);
    push @arm, arm_mcr(0, 0);
    push @arm, arm_mcr(0, 1);
    push @arm, arm_mov_imm(1, scalar(@gp));
    push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(2, 5);
    push @arm, arm_mcr(2, 3);
    my $wait_imem = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, scalar(@gp));
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_imem);
    push @arm, arm_mov_imm(1, scalar(@gp));
    push @arm, arm_mcr(1, 0);
    push @arm, arm_mov_imm(1, 0);
    push @arm, arm_mcr(1, 1);
    # xfer_len = 6 DWs per bank (not 12).  With burst_all, 4 banks consume 24
    # CPU DWs total, matching our 6-DW-per-bank payload.  xfer_len=12 makes
    # banks 2&3 read past the payload → zero B columns → cross-bank WMMA
    # reduces to (A[0]+A[1])·B[j]+C[j] instead of Σ_k A[k]·B[k][j]+C[j].
    push @arm, arm_mov_imm(1, 6);
    push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(1, 0x41);
    push @arm, arm_mcr(1, 3);
    my $wait_unpack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, scalar(@gp) + 24);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_unpack);
    push @arm, arm_mov_imm(1, 0); push @arm, arm_mcr(1, 4);
    push @arm, arm_mov_imm(1, 15); push @arm, arm_mcr(1, 7);
    push @arm, arm_mov_imm(1, 1); push @arm, arm_mcr(1, 5);
    my $wait_gpu = scalar @arm;
    push @arm, arm_mrc(3, 6);
    push @arm, arm_mov_imm(4, 5);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_gpu);
    # D_UNPACK source spans CPU DW [gp_len .. gp_len+23] (6 DWs × 4 banks).
    # Put D_PACK dest just past that so pack doesn't clobber unpack input.
    my $rb_cpu_base = scalar(@gp) + 24;
    push @arm, arm_mov_imm(1, 32); push @arm, arm_mcr(1, 0);
    push @arm, arm_mov_imm(1, $rb_cpu_base); push @arm, arm_mcr(1, 1);
    push @arm, arm_mov_imm(1, 2); push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(1, 0x43); push @arm, arm_mcr(1, 3);
    my $wait_pack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, $rb_cpu_base + 8);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_pack);
    push @arm, $HALT; push @arm, $HALT;
    my $arm_len = scalar @arm;
    $arm[2] = arm_b_idx(0x1, 2, $arm_len - 2);
    push @arm, $NOP if $arm_len % 2;

    # ── CPU DMEM payload: GPU prog then per-bank {A,B,C} tiles (burst_all) ──
    my @dmem;
    push @dmem, $_ for @gp;
    for my $bank (0..3) {
        push @dmem, (($a->[1] << 16) | $a->[0]) & 0xFFFFFFFF,
                    (($a->[3] << 16) | $a->[2]) & 0xFFFFFFFF;
        push @dmem, (($b->[1] << 16) | $b->[0]) & 0xFFFFFFFF,
                    (($b->[3] << 16) | $b->[2]) & 0xFFFFFFFF;
        push @dmem, (($c->[1] << 16) | $c->[0]) & 0xFFFFFFFF,
                    (($c->[3] << 16) | $c->[2]) & 0xFFFFFFFF;
    }
    push @dmem, 0 for 1..8;

    ic();
    my @c_cmd;
    my $imem_dw = int(($arm_len + 1) / 2);
    @c_cmd = cw(1, 0, $imem_dw, 0); iw($c_cmd[0], $c_cmd[1], 0x20);
    for (my $i = 0; $i < $arm_len; $i += 2) {
        my $lo = $arm[$i] & 0xFFFFFFFF;
        my $hi = ($i + 1 < $arm_len ? $arm[$i+1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    my $nw = scalar @dmem;
    my $dmem_dw = int(($nw + 1) / 2);
    @c_cmd = cw(2, 0, $dmem_dw, 0); iw($c_cmd[0], $c_cmd[1], 0);
    for (my $i = 0; $i < $nw; $i += 2) {
        my $lo = $dmem[$i] & 0xFFFFFFFF;
        my $hi = ($i + 1 < $nw ? $dmem[$i+1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    @c_cmd = cw(3, 0, 0, 0);            iw($c_cmd[0], $c_cmd[1], 0);
    @c_cmd = cw(4, $rb_cpu_base, 4, 0); iw($c_cmd[0], $c_cmd[1], 0);
    @c_cmd = cw(5, 0, 0, 0);            iw($c_cmd[0], $c_cmd[1], 0);
    id();
    my $done = pt(200, 50);
    return (0,0,0,0) unless $done;
    return cr();
}

sub ann_probe {
    banner("T_PROBE: multi-scenario WMMA bisection");

    # This is a 4×4 matrix MMA (not a scalar dot product).  With all 4 banks
    # broadcast the same B vector as their local B-row, the output per bank i
    # (= GPU-DMEM bank, TX lane == column j) is:
    #
    #     D[i][j] = Σ_k A[i][k] · B[k][j] + C[i][j]
    #             = B_input[j] · (Σ_k A_input[k]) + C_input[j]
    #
    # So S1/S2/S3 (uniform B) produce uniform lanes; S4/S5 (sparse B) produce
    # per-lane patterns that prove B-column isolation.

    # Each scenario: [label, A[4], B[4], C[4], exp_D[4] (bank0 lanes 0..3)]
    my @scenarios = (
        ["1) 1·1+0  ",  [0x3F80,0x3F80,0x3F80,0x3F80],     [0x3F80,0x3F80,0x3F80,0x3F80], [0,0,0,0],
            [0x4080,0x4080,0x4080,0x4080]],  # 4·1+0 = 4.0
        ["2) Asym·1 ",  [0x3F80,0x4000,0x4080,0x4100],     [0x3F80,0x3F80,0x3F80,0x3F80], [0,0,0,0],
            [0x4170,0x4170,0x4170,0x4170]],  # 15·1+0 = 15.0
        ["3) 1·2+4  ",  [0x3F80,0x3F80,0x3F80,0x3F80],     [0x4000,0x4000,0x4000,0x4000], [0x4080,0x4080,0x4080,0x4080],
            [0x4140,0x4140,0x4140,0x4140]],  # 4·2+4 = 12.0
        ["4) 1·0101 ",  [0x3F80,0x3F80,0x3F80,0x3F80],     [0,0x3F80,0,0x3F80],           [0,0,0,0],
            [0x0000,0x4080,0x0000,0x4080]],  # B[j]·4 = [0,4,0,4]
        ["5) B=1000 ",  [0x3F80,0x3F80,0x3F80,0x3F80],     [0x3F80,0,0,0],                [0,0,0,0],
            [0x4080,0x0000,0x0000,0x0000]],  # B[j]·4 = [4,0,0,0]
    );

    my @signature;
    my @exp_signature;
    for my $sc (@scenarios) {
        my ($lbl, $a, $b, $c, $exp) = @$sc;
        my $exp_lane_str = sprintf("%04X %04X %04X %04X", @$exp);
        phase("$lbl  exp_lanes=$exp_lane_str");
        my @tx = run_probe_tile($lbl, $a, $b, $c);
        my ($g_hex, $g_dec) = decode_pkt($tx[0], $tx[1]);
        my $all_ok = 1;
        for my $j (0..3) { $all_ok = 0 if $g_hex->[$j] != $exp->[$j]; }
        my $ok = $all_ok ? "[PASS]" : "[FAIL]";
        printf("  %s bank0 got_lanes = %04X %04X %04X %04X  (%.3f %.3f %.3f %.3f)\n",
            $ok, $g_hex->[0], $g_hex->[1], $g_hex->[2], $g_hex->[3],
            $g_dec->[0], $g_dec->[1], $g_dec->[2], $g_dec->[3]);
        printf("         exp_lanes  = %04X %04X %04X %04X\n", @$exp);
        push @signature, sprintf("%04X,%04X,%04X,%04X",
            $g_hex->[0], $g_hex->[1], $g_hex->[2], $g_hex->[3]);
        push @exp_signature, sprintf("%04X,%04X,%04X,%04X", @$exp);
        if ($all_ok) { $pass++ } else { $fail++ }
    }

    # ── Diagnosis ──
    my $sig = join(" | ", @signature);
    print "\n  [SIGNATURE] " . $sig . "\n";
    my $exp_sig = join(" | ", @exp_signature);
    print "  [EXPECTED]  " . $exp_sig . "\n\n";

    if ($sig eq $exp_sig) {
        print "  [DIAG]      ALL PASS — tensor core D[i][j] = Σ_k A[i][k]·B[k][j] + C[i][j]\n";
        print "              is bit-exact on every scenario and every lane.\n";
    } else {
        print "  [DIAG]      Mismatch — at least one scenario's lane values are off.\n";
        print "              Inspect the per-scenario lane diff above; likely causes:\n";
        print "              · K-lane dropouts: lanes that should sum Σ A·B come out low\n";
        print "              · C-add path dead: all lanes match A·B but ignore C\n";
        print "              · UNPACK mis-striping: banks 2/3 zero → (A[0]+A[1])·B[j]+C[j]\n";
        print "              · STORE addr mismatch: pack src ≠ WMMA.STORE target\n";
    }
}

# Legacy wrapper (kept so previous muscle memory still works)
sub ann_probe_legacy {
    banner("T_PROBE: single-tile WMMA (A=1.0, B=1.0, C=0 → D=4.0 exact)");
    hard_reset();

    # ── GPU program: load A, B, C; MMA; store to GPU DMEM[32..35] per bank ─
    my @gp;
    push @gp, enc_movi_dt(0, 0, 0);                          # 0: R0 = 0 (A base)
    push @gp, enc_wmma_load(0, 4, 0, 0);                     # 1: WMMA.LOAD.A R4, [R0]
    push @gp, enc_movi_dt(0, 0, 4);                          # 2: R0 = 4 (B base)
    push @gp, enc_wmma_load(1, 8, 0, 0);                     # 3: WMMA.LOAD.B R8, [R0]
    push @gp, enc_movi_dt(0, 0, 8);                          # 4: R0 = 8 (C base)
    push @gp, enc_wmma_load(2, 12, 0, 0);                    # 5: WMMA.LOAD.C R12, [R0]
    push @gp, enc_wmma_mma(12, 4, 8, 12);                    # 6: D = A·B + C
    push @gp, enc_movi_dt(0, 0, 32);                         # 7: R0 = 32 (out)
    push @gp, enc_wmma_store(12, 0, 0);                      # 8: WMMA.STORE D, [R0]
    push @gp, (($OP_RET & 0x1F) << 27);                      # 9: RET

    # Pad @gp to an even count for LOAD_DMEM DW packing
    push @gp, 0 while @gp % 2;

    # ── ARM program: D_IMEM GPU prog, D_UNPACK tile data, launch, D_PACK, halt ─
    # Same style as load's copy_prog — CR10 gate, single DMA kicks, spin waits.
    my @arm;
    # Thread-0 gate
    push @arm, arm_mrc(11, 10);                             # 0
    push @arm, arm_cmp_imm(11, 0);                          # 1
    push @arm, 0;                                            # 2 patched → B.NE halt
    # Phase A: D_IMEM the GPU program (CPU[0..scalar(@gp)-1] → GPU IMEM)
    push @arm, arm_mov_imm(0, 0);                           # 3: R0 = 0
    push @arm, arm_mcr(0, 0);                                # 4: CR0 = 0 (src)
    push @arm, arm_mcr(0, 1);                                # 5: CR1 = 0 (dst)
    push @arm, arm_mov_imm(1, scalar(@gp));                 # 6: len = |gp|
    push @arm, arm_mcr(1, 2);                                # 7
    push @arm, arm_mov_imm(2, 5);                           # 8: op = D_IMEM
    push @arm, arm_mcr(2, 3);                                # 9: kick
    my $wait_imem = scalar @arm;
    push @arm, arm_mrc(3, 9);                                # wait CR9 == |gp|
    push @arm, arm_mov_imm(4, scalar(@gp));
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_imem);
    # Phase B: D_UNPACK the 12 32b tile words (3 tiles × 4 words) from CPU[|gp|..]
    push @arm, arm_mov_imm(1, scalar(@gp));                 # R1 = |gp| (src)
    push @arm, arm_mcr(1, 0);                                # CR0 = src
    push @arm, arm_mov_imm(1, 0);                           # dst GPU DMEM = 0
    push @arm, arm_mcr(1, 1);
    push @arm, arm_mov_imm(1, 12);                          # len = 12 words/bank
    push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(1, 0x41);                        # D_UNPACK burst_all
    push @arm, arm_mcr(1, 3);
    my $wait_unpack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, scalar(@gp) + 48);            # target = src + 12*4
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_unpack);
    # Phase C: Launch GPU
    push @arm, arm_mov_imm(1, 0); push @arm, arm_mcr(1, 4); # CR4 = pc 0
    push @arm, arm_mov_imm(1, 15); push @arm, arm_mcr(1, 7); # CR7 = mask 0xF
    push @arm, arm_mov_imm(1, 1); push @arm, arm_mcr(1, 5); # CR5 = start
    my $wait_gpu = scalar @arm;
    push @arm, arm_mrc(3, 6);                                # CR6 = {idle, active, done}
    push @arm, arm_mov_imm(4, 5);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_gpu);
    # Phase D: D_PACK GPU DMEM[32..35]/bank → CPU DMEM[scalar(@gp)+12 ..]
    my $rb_cpu_base = scalar(@gp) + 12;     # in 32b words
    push @arm, arm_mov_imm(1, 32); push @arm, arm_mcr(1, 0); # CR0 = GPU src
    push @arm, arm_mov_imm(1, $rb_cpu_base); push @arm, arm_mcr(1, 1);
    push @arm, arm_mov_imm(1, 2); push @arm, arm_mcr(1, 2);  # len 2/bank
    push @arm, arm_mov_imm(1, 0x43); push @arm, arm_mcr(1, 3); # D_PACK burst_all
    my $wait_pack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, $rb_cpu_base + 8);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_pack);
    # halt
    push @arm, $HALT;
    push @arm, $HALT;
    my $arm_len = scalar @arm;
    $arm[2] = arm_b_idx(0x1, 2, $arm_len - 2);    # B.NE halt for threads 1..3
    push @arm, $NOP if $arm_len % 2;

    # ── CPU DMEM layout (send all in ONE packet): ─────────────
    #   [0 .. |gp|-1]           : GPU program (as 32b ARM words)
    #   [|gp| .. |gp|+11]       : tile data  (A[0..3], B[0..3], C[0..3])  per bank
    #                             burst_all: 4 banks × 12 words = 48 CPU words
    my @dmem;
    push @dmem, $_ for @gp;
    for my $bank (0..3) {
        # A: 4 BF16 0x3F80 packed as 2 32b words (x3F803F80) × 2
        push @dmem, 0x3F803F80, 0x3F803F80;
        # B: same
        push @dmem, 0x3F803F80, 0x3F803F80;
        # C: 4 BF16 0x0000 packed as 2 zero words
        push @dmem, 0, 0;
    }
    # readback area: initialized to 0 (8 words × 4 banks = 32 words) — not strictly
    # needed since D_PACK will fill, but keep for cleanliness.
    push @dmem, 0 for 1..8;

    # ── Send packet: LOAD_IMEM(arm) + LOAD_DMEM(gp+data) + CPU_START + RB + SEND ──
    phase(sprintf("ARM=%d instrs · GPU=%d instrs · CPU DMEM=%d words",
          $arm_len, scalar(@gp), scalar(@dmem)));

    ic();
    my @c;
    # LOAD_IMEM  (arm)
    my $imem_dw = int(($arm_len + 1) / 2);
    @c = cw(1, 0, $imem_dw, 0); iw($c[0], $c[1], 0x20);
    for (my $i = 0; $i < $arm_len; $i += 2) {
        my $lo = $arm[$i] & 0xFFFFFFFF;
        my $hi = ($i + 1 < $arm_len ? $arm[$i+1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    # LOAD_DMEM (gp + tiles)
    my $nw    = scalar @dmem;
    my $dmem_dw = int(($nw + 1) / 2);
    @c = cw(2, 0, $dmem_dw, 0); iw($c[0], $c[1], 0);
    for (my $i = 0; $i < $nw; $i += 2) {
        my $lo = $dmem[$i] & 0xFFFFFFFF;
        my $hi = ($i + 1 < $nw ? $dmem[$i+1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    # CPU_START + READBACK + SEND_PKT
    @c = cw(3, 0, 0, 0);                 iw($c[0], $c[1], 0);
    @c = cw(4, $rb_cpu_base, 4, 0);      iw($c[0], $c[1], 0);
    @c = cw(5, 0, 0, 0);                 iw($c[0], $c[1], 0);
    id();
    my $done = pt(200, 50);
    dump_st("post-probe");
    my @tx = cr();

    # Expected: D[i,j] = 4.0 = BF16 0x4080 for every slot → packed DW 0x40804080_40804080
    my $exp_dw = 0x40804080;
    printf("\n  GOT  TX[0] = %08X_%08X  (bank0 · bank1 from snoop)\n", $tx[0], $tx[1]);
    printf("  EXP  TX[*] = %08X_%08X  (every bank = 4×0x4080 since D = 4.0 exact)\n",
        $exp_dw, $exp_dw);
    my ($g_hex, $g_dec) = decode_pkt($tx[0], $tx[1]);
    printf("  GOT  bank0 BF16 = %04X %04X %04X %04X  →  %+.3f %+.3f %+.3f %+.3f\n",
        $g_hex->[0], $g_hex->[1], $g_hex->[2], $g_hex->[3],
        $g_dec->[0], $g_dec->[1], $g_dec->[2], $g_dec->[3]);

    if ($tx[0] == $exp_dw && $tx[1] == $exp_dw) {
        print "  [PASS] probe: MAC + tensor core produce D = 4.0 exactly\n";
        print "         → BF16 math matches the exact all-ones reference.  Full-run drift must be in\n";
        print "           K-accumulation beyond the 4-wide inner product, or in\n";
        print "           the ReLU / cvt paths.  Look at L1 / L2 activations.\n";
        $pass++;
    } else {
        print "  [FAIL] probe: MAC core drift on a 4-wide all-ones product.\n";
        print "         → the bitfile's synthesized BF16 FPU or tensor core\n";
        print "           is NOT matching the exact reference.  Check bf16fpu.v,\n";
        print "           tc_top.v, bf16sa.v, and the generated BF16 IP bindings.\n";
        $fail++;
    }
}

# Convenience: full end-to-end (load then run).
sub tann_full { ann_load_weights(); ann_run_inference(); }

# ══════════════════════════════════════════════════════════════
#  Summary
# ══════════════════════════════════════════════════════════════
sub summary {
    print "\n" . "=" x 50 . "\n";
    printf("  PASSED: %d  FAILED: %d  TOTAL: %d\n", $pass, $fail, $pass+$fail);
    printf("  MMIO: %d txns, %d errors\n", $txn, $err);
    print "=" x 50 . "\n";
    print($fail == 0 && $pass > 0 ? ">>> ANN FULL MODEL PASSED <<<\n"
                                   : ">>> ANN FULL MODEL FAILED <<<\n") if $pass+$fail > 0;
    print "\n";
}

# ── Dispatch ──────────────────────────────────────────────────
$V = 1;
if (grep { $_ eq '-q' } @ARGV) { $V = 0; @ARGV = grep { $_ ne '-q' } @ARGV }
my $c = $ARGV[0] || "model";

if    ($c eq "model" || $c eq "tann" || $c eq "ann")   { tann_full();         summary(); }
elsif ($c eq "load"  || $c eq "preload")                 { ann_load_weights(); summary(); }
elsif ($c eq "run"   || $c eq "infer")                   { ann_run_inference(); summary(); }
elsif ($c eq "classes" || $c eq "run_classes")           { ann_run_inference("classes"); summary(); }
elsif ($c eq "model_classes" || $c eq "ann_classes")     { ann_load_weights(); ann_run_inference("classes"); summary(); }
elsif ($c eq "classdefs" || $c eq "labels")              { print_class_definitions(); }
elsif ($c eq "diag")                                      { ann_diag();          summary(); }
elsif ($c eq "probe" || $c eq "tile1")                   { ann_probe();         summary(); }
elsif ($c eq "probe_k" || $c eq "probek")                { ann_probe_k();       summary(); }
elsif ($c eq "probe_w" || $c eq "probe_weights")         { ann_probe_weights(); summary(); }
elsif ($c eq "probe_l" || $c eq "probe_layout")          { ann_probe_layout();  summary(); }
elsif ($c eq "probe_x0")                                  { ann_probe_x0();      summary(); }
elsif ($c eq "probe_x1")                                  { ann_probe_x1();      summary(); }
elsif ($c eq "probe_wa")                                  { ann_probe_wa(defined($ARGV[1]) ? int($ARGV[1]) : 0); summary(); }
elsif ($c eq "status") { dump_st("status"); }
elsif ($c eq "result") { cr(); }
elsif ($c eq "reset")  { hard_reset(); }
elsif ($c eq "clear")  { rw($SW_CMD, $CMD_CLEAR); usleep(10000); rw($SW_CMD, 0); print "Cleared\n"; }
else {
    print "\nUsage: sw/model_test <command> [-q]\n\n";
    print "ANN stages:\n";
    print "  load | preload     stream weights → GPU DMEM (slow, ~60 packets)\n";
    print "  run  | infer       run inference + readback (assumes `load` already ran)\n";
    print "  classes            run 4 real rows: DoS/NORMAL/c_ci_na_1/c_se_na_1\n";
    print "  model_classes      load weights, then run the 4-class real-row demo\n";
    print "  classdefs | labels show class IDs and preprocessing definition\n";
    print "  model | tann | ann full pipeline (= load + run)   [default]\n\n";
    print "Diagnostics:\n";
    print "  probe | tile1      5-scenario WMMA bisection · fault-pattern signature\n";
    print "  probe_k            K-loop WMMA chain-accum (K=1,2,5,10,11)\n";
    print "  probe_w            spot-check GPU DMEM weights vs host image (post-load)\n";
    print "  probe_l            spot-check CPU DMEM input + sched records vs host image\n";
    print "  probe_x0           spot-check input data in GPU DMEM after sched D_UNPACK\n";
    print "                     (run after `load` + `run`; 10 spots, full coverage)\n";
    print "  probe_x1           spot-check L1 activations in GPU DMEM vs IP RTL reference\n";
    print "                     (run after `load` + `run`; reference is hardcoded)\n";
    print "  probe_wa [ot]      exhaustive scan of all 40 L1 weights/bank in one tile\n";
    print "                     (default ot=0; 160 BF16 values checked in one tile)\n";
    print "  diag               HALT / DMA / full-tile / K-loop bisection\n\n";
    print "Utils: status | result | reset | clear\n\n";
    print "Typical iteration loop:\n";
    print "  sw/model_test load       # once per FPGA programming\n";
    print "  sw/model_test run        # as many times as you want\n\n";
    print "Environment:\n";
    print "  MODEL_DIR    dir with ann_weights_dmem_t[0-3].hex (default: sw/model)\n\n";
}
