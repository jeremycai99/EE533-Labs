#!/usr/bin/perl -w
# model_test — full ANN model HW test (40→96→42→4)
#
# Mirrors model_tb.v "HW scheduler" (T5) — the on-SoC scheduler program runs
# the 36-tile outer loop + DMA + GPU kicks. Thread 0 is gated-in via the new
# CR10 MRC (CPU thread-ID read) so only one thread executes the scheduler;
# threads 1..3 halt immediately.  Previously relied on a sim-only regfile
# poke; v2.0 uses the CR10 TID path (requires cp10_regfile.v + cpu_mt.v +
# soc.v changes shipped together).
#
# Large injection packets are split into multiple <60 DW packets so each
# fits inside the SoC's MMIO scratch buffer.  Each sub-packet just does a
# LOAD_DMEM (or LOAD_IMEM) with no CPU_START, so pkt_proc drains back to
# IDLE between packets and the CPU DMEM retains the cumulative data.
# A final packet triggers CPU_START + READBACK + SEND_PKT.
#
# Weight layout follows train_ann_hw_relu.py: W1(96×40), B1(96),
# W2(42×96), B2(42), W3(4×42), B3(4).  Flattened as ANN_WEIGHT_LINEAR_COUNT
# = 8182 BF16 values, striped across 4 thread hex files (2048 each).
#
# Expected output (packet-major BF16, from CoreGen-backed RTL/IP reference):
#   pkt0: 0xC1DB_C1CD_415E_C0E8
#   pkt1: 0xC074_406F_C21F_415D
#   pkt2: 0xC31E_C33C_C28D_4397
#   pkt3: 0xC315_C327_BF0A_437A

use strict;
use Time::HiRes qw(usleep);

# ══════════════════════════════════════════════════════════════
#  SoC MMIO map
# ══════════════════════════════════════════════════════════════
my $SW_DATA_HI = 0x2000200; my $SW_DATA_LO = 0x2000204;
my $SW_CTRL    = 0x2000208; my $SW_CMD     = 0x200020c;
my $HW_ST      = 0x2000210;
my $HW_W0H     = 0x2000214; my $HW_W0L     = 0x2000218;
my $HW_W1H     = 0x200021c; my $HW_W1L     = 0x2000220;
my $CMD_ENABLE = 0x02;
my $CMD_CLEAR  = 0x04;
my $CMD_DRAIN  = 0x08;

# ══════════════════════════════════════════════════════════════
#  ANN constants (mirror model_tb localparams)
# ══════════════════════════════════════════════════════════════
my $ANN_N_FEAT              = 40;
my $ANN_H1                  = 96;
my $ANN_H2                  = 42;
my $ANN_N_CLASS             = 4;
my $ANN_MODEL_THREAD_DEPTH  = 2048;
my $ANN_WEIGHT_LINEAR_COUNT = 8182;
my $ANN_L1_W_OFF = 0;
my $ANN_L1_B_OFF = $ANN_L1_W_OFF + $ANN_H1 * $ANN_N_FEAT;           # 3840
my $ANN_L2_W_OFF = $ANN_L1_B_OFF + $ANN_H1;                          # 3936
my $ANN_L2_B_OFF = $ANN_L2_W_OFF + $ANN_H2 * $ANN_H1;                # 7968
my $ANN_L3_W_OFF = $ANN_L2_B_OFF + $ANN_H2;                          # 8010
my $ANN_L3_B_OFF = $ANN_L3_W_OFF + $ANN_N_CLASS * $ANN_H2;           # 8178

my $ANN_HW_GPU_PARAM_BASE   = 2208;
my $ANN_HW_GPU_W1_BASE      = 0;
my $ANN_HW_GPU_B1_BASE      = 960;
my $ANN_HW_GPU_W2_BASE      = 1056;
my $ANN_HW_GPU_B2_BASE      = 2112;
my $ANN_HW_GPU_W3_BASE      = 2156;
my $ANN_HW_GPU_B3_BASE      = 2200;
my $ANN_HW_GPU_X0_BASE      = 2240;
my $ANN_HW_GPU_X1_BASE      = 2280;
my $ANN_HW_GPU_X2_BASE      = 2380;
my $ANN_HW_GPU_X3_BASE      = 2424;
my $ANN_HW_PRELOAD0_WPB     = 1020;
my $ANN_HW_PRELOAD1_WPB     = 82;
my $ANN_HW_PRELOAD1_GPU_BASE = 2040;
my $ANN_HW_COPY_BUF_BASE    = 16;
my $ANN_HW_GPUK_CPU_BASE    = 64;
my $ANN_HW_INPUT_CPU_BASE   = 128;
my $ANN_HW_SCHED_CPU_BASE   = 256;
my $ANN_HW_READBACK_CPU_BASE = 800;
my $ANN_HW_SCHED_RECORD_WORDS = 13;
my $ANN_HW_TILE_COUNT       = 36;
my $ANN_HW_GPU_LINEAR_PC    = 0;
my $ANN_HW_GPU_RELU_PC      = 28;
my $ANN_HW_DMA_WAIT_PARAM   = 16;
my $ANN_HW_DMA_WAIT_INPUT   = 40;
my $ANN_HW_DMA_WAIT_GPU     = 400;
my $ANN_HW_DMA_WAIT_COPY_LONG  = 50000;
my $ANN_HW_DMA_WAIT_COPY_SHORT = 5000;

my $NOP     = 0xE1A00000;
my $HALT    = 0xEAFFFFFE;
my $SHIFT_LSL = 0b00;
my $SHIFT_LSR = 0b01;
my $SHIFT_ASR = 0b10;

# Chunk size for multi-packet LOAD: DW count per sub-packet, well below
# the SoC MMIO scratch buffer (observed ceiling ~64 DWs/packet).
my $CHUNK_DW = 40;

my $MODEL_DIR = "sw/model";     # override with MODEL_DIR env var
$MODEL_DIR = $ENV{MODEL_DIR} if exists $ENV{MODEL_DIR};

# Label encoding saved by Final/model/train_ann_hw_relu.py / ann_config.txt.
my @ANN_CLASS_NAMES = ("DoS", "NORMAL", "c_ci_na_1", "c_se_na_1");
my @ANN_CLASS_DESC = (
    "merged denial-of-service traffic: every raw label ending in _DoS",
    "benign IEC104 traffic",
    "IEC104 C_CI_NA_1 counter interrogation command traffic",
    "IEC104 C_SE_NA_1 normalized set-point command traffic",
);

# Four real custom-dataset rows, one per trained class, preprocessed exactly as:
# raw 111 features -> append 20 COT/type_id ratio features -> StandardScaler
# -> feat_idx.npy top-40 select -> BF16 truncation.
my @CLASS_DEMO_SOURCE = (
    "custom_script row 1197 raw=c_sc_na_1_DoS merged=DoS",
    "custom_script row 374 raw=NORMAL",
    "custom_script row 232 raw=c_ci_na_1",
    "custom_script row 1683 raw=c_se_na_1",
);
my @CLASS_DEMO_EXPECT = (0, 1, 2, 3);
my @CLASS_DEMO_INPUT_BF16 = (
    [ 0xBE19, 0xBE8F, 0xBE4D, 0xBF44, 0xBDB4, 0xBDD3, 0xBF3E, 0xBDC4, 0xBDE4, 0xBE6E, 0xBC87, 0xBF45, 0xBF47, 0xBDD2, 0x3F0A, 0xBEA1, 0xBE81, 0xBD82, 0xBEA0, 0xBF44, 0xBE75, 0xBF0D, 0xBF48, 0xBF27, 0x3DDC, 0xBE0C, 0x3DE1, 0x3B80, 0xBF44, 0xBF36, 0x3F01, 0xBF11, 0x3E6D, 0xBD86, 0xBF02, 0xBE26, 0xBEC1, 0xBF0D, 0xBF10, 0xBEB5 ],
    [ 0xBE19, 0xBE8F, 0xBE4D, 0xBF44, 0xBDB4, 0xBDD4, 0xBF3E, 0xBDC6, 0xBDE4, 0xBE6E, 0x3E4F, 0xBF45, 0xBF47, 0xBDD4, 0x403F, 0x4049, 0xBE81, 0xBD81, 0xBEA0, 0xBF44, 0xBE75, 0xBF0D, 0xBF48, 0xBF27, 0xBE44, 0xBE4C, 0xBF7A, 0xBDE5, 0xBF44, 0xBF36, 0xBF07, 0xBF11, 0xBFC3, 0xBD91, 0xBF02, 0x4098, 0x3E63, 0xBF0D, 0xBF10, 0xBEB5 ],
    [ 0xBE19, 0xBE8F, 0xBE4D, 0xBF44, 0xBDB5, 0xBDD4, 0xBF3E, 0xBDC4, 0xBDE4, 0xBE6E, 0xBCD1, 0xBF45, 0xBF47, 0xBDD2, 0x3F67, 0xBEA1, 0xBE81, 0xBD82, 0xBEA0, 0xBF44, 0xBE75, 0xBF0D, 0xBF48, 0xBF27, 0x3E9D, 0xBE02, 0x3D8D, 0x3B80, 0xBF44, 0xBF36, 0x3F2B, 0xBF11, 0x3EEA, 0xBD88, 0xBF02, 0xBE34, 0x3E63, 0xBF0D, 0xBF10, 0xBEB5 ],
    [ 0xBE19, 0xBE8F, 0xBE4D, 0xBF44, 0xBDB5, 0xBDD4, 0xBF3E, 0xBDC5, 0xBDE4, 0xBE6E, 0x3DF2, 0xBF45, 0xBF47, 0xBDD4, 0x3F67, 0xBEA1, 0xBE81, 0xBD82, 0xBEA0, 0xBF44, 0xBE75, 0xBF0D, 0xBF48, 0xBF27, 0x3E52, 0xBE45, 0xBF0D, 0x3B80, 0xBF44, 0xBF36, 0x3C38, 0xBF11, 0x3EF7, 0xBD8E, 0xBF02, 0x3E19, 0xBD9F, 0xBF0D, 0xBF10, 0xBEB5 ],
);

# ══════════════════════════════════════════════════════════════
#  State
# ══════════════════════════════════════════════════════════════
my ($pass, $fail, $txn, $err) = (0, 0, 0, 0);
my ($ps, $wc, $V) = (0, 0, 1);
my $input_mode = "synthetic";
my @weights = ([], [], [], []);   # per-thread BF16 weights
my @gpu_bank = ([], [], [], []);   # per-bank GPU DMEM image (16-bit words)
my @copy_prog;                     # ARM instrs (32b)
my @gpu_prog;                      # GPU instrs (32b)
my @sched_prog;                    # ARM instrs (32b)
my @final_dmem;                    # CPU DMEM image (32b words)
my $copy_prog_len  = 0;
my $gpu_prog_len   = 0;
my $sched_prog_len = 0;
my $final_dmem_words = 0;

# ══════════════════════════════════════════════════════════════
#  MMIO primitives
# ══════════════════════════════════════════════════════════════
sub rw { my($a,$v)=@_; $v &= 0xFFFFFFFF; $txn++;
    system(sprintf("regwrite 0x%08x 0x%08x >/dev/null 2>&1",$a,$v)); }
sub rr { my($a)=@_; $txn++;
    my @o=`regread 0x${\sprintf("%08x",$a)} 2>/dev/null`;
    for(@o){return hex($1) if/:\s+(0x[0-9a-f]+)/i}
    $err++; return 0; }
sub dump_st { my ($lbl) = @_; my $s = rr($HW_ST);
    printf("    [%-12s] ST=%08X rdy=%d buf=%2d dr=%d drd=%d txa=%d txd=%d txw=%2d pkt=%d\n",
        $lbl, $s, ($s>>7)&1, ($s>>8)&0x3F, ($s>>4)&1, ($s>>5)&1,
        ($s>>3)&1, ($s>>2)&1, ($s>>16)&0x3F, $s&3) if $V;
    return $s; }
sub ic  { rw($SW_CMD, $CMD_CLEAR | $CMD_ENABLE); usleep(10000);
          rw($SW_CMD, $CMD_ENABLE);              usleep(1000);
          $ps = 0; $wc = 0; }
sub hard_reset {
    rw($SW_CMD, $CMD_DRAIN | $CMD_ENABLE); usleep(20000);
    rw($SW_CMD, 0);                         usleep(5000);
    rw($SW_CMD, $CMD_CLEAR);                usleep(20000);
    rw($SW_CMD, 0);                         usleep(5000);
    rw($SW_CMD, $CMD_CLEAR | $CMD_ENABLE);  usleep(20000);
    rw($SW_CMD, $CMD_ENABLE);               usleep(5000);
    $ps = 0; $wc = 0;
    dump_st("reset");
}
sub iw { my($h,$l,$c) = @_;
    rw($SW_DATA_HI, $h); rw($SW_DATA_LO, $l); rw($SW_CTRL, $c);
    $ps ^= 1; rw($SW_CMD, $CMD_ENABLE | $ps); usleep(500); $wc++; }
sub id {
    printf("  [DRAIN wc=%d]\n", $wc) if $V;
    rw($SW_CMD, $CMD_DRAIN | $CMD_ENABLE | $ps); usleep(1000);
    for my $i (0..29) { usleep(5000); my $s = rr($HW_ST);
        return if ($s>>5) & 1; }
    print "  [DRAIN] WARN drd not asserted\n"; }
sub np { iw($NOP, $NOP, 0); }
sub cw { my($o,$a,$n,$p) = @_;
    ((($o&0xF)<<28) | (($a&0xFFF)<<16) | ($n&0xFFFF), $p & 0xFFFFFFFF) }
sub pt { my($n,$ms) = @_; $n ||= 600; $ms ||= 50;
    my $start_st = rr($HW_ST);
    printf("  [POLL] start ST=0x%08X (pkt=%d drd=%d txd=%d)\n",
        $start_st, $start_st & 3, ($start_st>>5)&1, ($start_st>>2)&1);
    my $last_st = $start_st;
    for my $i (0..$n-1) { usleep($ms*1000); my $s = rr($HW_ST);
        if (($s>>2)&1) { printf("  [POLL] done @ %d (ST=0x%08X)\n", $i+1, $s); return 1 }
        # Every ~5s, dump a status snapshot so we can see if pkt_proc is making progress
        if (($i+1) % (int(5000/$ms) || 1) == 0 || $s != $last_st) {
            printf("    [poll-%4d  %4dms] ST=0x%08X  pkt=%d drd=%d txa=%d txd=%d buf=%d txw=%d\n",
                $i+1, ($i+1)*$ms, $s, $s & 3, ($s>>5)&1, ($s>>3)&1,
                ($s>>2)&1, ($s>>8)&0x3F, ($s>>16)&0x3F);
            $last_st = $s;
        }
    }
    print "  [POLL] TIMEOUT\n"; 0 }
sub cr { my @w; for my $r ($HW_W0H,$HW_W0L,$HW_W1H,$HW_W1L) { push @w, rr($r) }
    printf("  TX[0]=%08X_%08X TX[1]=%08X_%08X\n", @w); @w }
sub banner { print "\n" . "=" x 64 . "\n  $_[0]\n" . "=" x 64 . "\n\n" }
sub phase  { printf("  ── %s ──\n", $_[0]) if $V }

# ══════════════════════════════════════════════════════════════
#  ARM instruction encoders (port of model_tb arm_* functions)
# ══════════════════════════════════════════════════════════════
sub arm_mov_imm   { my ($rd,$imm) = @_;
    0xE3A00000 | (($rd & 0xF) << 12) | ($imm & 0xFF) }
sub arm_ldr_imm   { my ($rd,$rn,$off) = @_;
    0xE5900000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12) | ($off & 0xFFF) }
sub arm_str_imm   { my ($rd,$rn,$off) = @_;
    0xE5800000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12) | ($off & 0xFFF) }
sub arm_add_imm   { my ($rd,$rn,$imm) = @_;
    0xE2800000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12) | ($imm & 0xFF) }
sub arm_sub_imm   { my ($rd,$rn,$imm) = @_;
    0xE2400000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12) | ($imm & 0xFF) }
sub arm_cmp_imm   { my ($rn,$imm) = @_;
    0xE3500000 | (($rn & 0xF) << 16) | ($imm & 0xFF) }
sub arm_cmp_reg   { my ($rn,$rm) = @_;
    0xE1500000 | (($rn & 0xF) << 16) | ($rm & 0xF) }
sub arm_add_reg   { my ($rd,$rn,$rm) = @_;
    0xE0800000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12) | ($rm & 0xF) }
sub arm_mov_shift { my ($rd,$rm,$st,$sh) = @_;
    0xE1A00000 | (($rd & 0xF) << 12) | (($sh & 0x1F) << 7) | (($st & 0x3) << 5) | ($rm & 0xF) }
sub arm_orr_shift { my ($rd,$rn,$rm,$st,$sh) = @_;
    0xE1800000 | (($rn & 0xF) << 16) | (($rd & 0xF) << 12)
              | (($sh & 0x1F) << 7) | (($st & 0x3) << 5) | ($rm & 0xF) }
sub arm_mcr       { my ($rd,$crn) = @_;
    0xEE000A10 | (($crn & 0xF) << 16) | (($rd & 0xF) << 12) }
sub arm_mrc       { my ($rd,$crn) = @_;
    0xEE100A10 | (($crn & 0xF) << 16) | (($rd & 0xF) << 12) }
sub arm_b_idx     { my ($cond,$from,$target) = @_;
    my $off24 = ($target - $from - 2) & 0xFFFFFF;
    (($cond & 0xF) << 28) | (0b101 << 25) | (0 << 24) | $off24 }

# ══════════════════════════════════════════════════════════════
#  GPU instruction encoders
# ══════════════════════════════════════════════════════════════
#   opcode[31:27], dt[26], imm[25:24], rd[23:20], ra[19:16], rb[15:12], offset[11:0] for R
#   opcode[31:27], dt[26], imm[25:24], rd[23:20], ra[19:16], imm16[15:0]             for I
my $OP_ADDI    = 0b10011;
my $OP_LD      = 0b00010;
my $OP_MOVI    = 0b00100;
my $OP_SETP    = 0b10101;
my $OP_BRA     = 0b10111;
my $OP_PBRA    = 0b11000;
my $OP_RET     = 0b11001;
my $OP_MAX     = 0b01010;
my $WMMA_MMA   = 0b11101;
my $WMMA_LOAD  = 0b11110;
my $WMMA_STORE = 0b11111;
my $COMP_NE    = 0b01;

sub enc_r { my ($op,$dt,$rd,$ra,$rb) = @_;
    (($op & 0x1F) << 27) | (($dt & 1) << 26) | (($rd & 0xF) << 20)
    | (($ra & 0xF) << 16) | (($rb & 0xF) << 12) }
sub enc_i { my ($op,$dt,$rd,$ra,$imm) = @_;
    (($op & 0x1F) << 27) | (($dt & 1) << 26) | (($rd & 0xF) << 20)
    | (($ra & 0xF) << 16) | ($imm & 0xFFFF) }
sub enc_movi_dt { my ($dt,$rd,$imm) = @_;
    enc_i($OP_MOVI, $dt, $rd, 0, $imm) }
sub enc_wmma_load  { my ($sel,$rd,$ra,$off) = @_;
    (($WMMA_LOAD & 0x1F) << 27) | (1 << 26) | (($sel & 3) << 24)
    | (($rd & 0xF) << 20) | (($ra & 0xF) << 16) | ($off & 0xFFFF) }
sub enc_wmma_store { my ($rd,$ra,$off) = @_;
    (($WMMA_STORE & 0x1F) << 27) | (1 << 26) | (0 << 24)
    | (($rd & 0xF) << 20) | (($ra & 0xF) << 16) | ($off & 0xFFFF) }
sub enc_wmma_mma   { my ($rd,$ra,$rb,$rc) = @_;
    (($WMMA_MMA & 0x1F) << 27) | (1 << 26) | (0 << 24)
    | (($rd & 0xF) << 20) | (($ra & 0xF) << 16) | (($rb & 0xF) << 12)
    | (($rc & 0xF) << 8) }
sub enc_setp { my ($dt,$cmp,$psel,$ra,$rb) = @_;
    (($OP_SETP & 0x1F) << 27) | (($dt & 1) << 26) | (($cmp & 3) << 24)
    | ((($psel & 3) & 0x3) << 16) | (($ra & 0xF) << 20) | (($rb & 0xF) << 12) }
sub enc_bra  { my ($target) = @_;
    (($OP_BRA & 0x1F) << 27) | ($target & 0x07FFFFFF) }
sub enc_pbra { my ($psel,$target,$reconv) = @_;
    (($OP_PBRA & 0x1F) << 27) | (($psel & 3) << 25)
    | (($target & 0x1FFF) << 12) | ($reconv & 0xFFF) }

# ══════════════════════════════════════════════════════════════
#  BF16 helpers
# ══════════════════════════════════════════════════════════════
sub pack4_bf16 {
    my ($v0,$v1,$v2,$v3) = @_;
    # returns [HI32, LO32]
    my $lo = (($v1 & 0xFFFF) << 16) | ($v0 & 0xFFFF);
    my $hi = (($v3 & 0xFFFF) << 16) | ($v2 & 0xFFFF);
    [$hi & 0xFFFFFFFF, $lo & 0xFFFFFFFF]
}
sub pack2_u16 {
    my ($lo16,$hi16) = @_;
    (($hi16 & 0xFFFF) << 16) | ($lo16 & 0xFFFF)
}

# Load 4 thread weight files from $MODEL_DIR.
#
# Expected layout:
#   $MODEL_DIR/ann_weights_dmem_t0.hex
#   $MODEL_DIR/ann_weights_dmem_t1.hex
#   $MODEL_DIR/ann_weights_dmem_t2.hex
#   $MODEL_DIR/ann_weights_dmem_t3.hex
#
# File format: 2048 lines, one BF16 value per line, 4 hex digits (no 0x prefix).
# Files are the same ones model_tb.v reads from Final/model/GPU_HW_RELU/.
sub load_weights {
    die "MODEL_DIR '$MODEL_DIR' does not exist\n" unless -d $MODEL_DIR;
    for my $t (0..3) {
        my $f = "$MODEL_DIR/ann_weights_dmem_t$t.hex";
        open(my $fh, "<", $f)
            or die "Can't open $f: $!\nExpected 4 hex files (t0..t3) in $MODEL_DIR\n";
        my @w;
        while (my $ln = <$fh>) {
            $ln =~ s/\s+//g; next if $ln eq "" || $ln =~ /^#/;
            push @w, hex($ln);
        }
        close $fh;
        push @w, 0 while @w < $ANN_MODEL_THREAD_DEPTH;
        die sprintf("%s has %d entries (expected %d)\n", $f, scalar(@w), $ANN_MODEL_THREAD_DEPTH)
            if @w != $ANN_MODEL_THREAD_DEPTH;
        $weights[$t] = \@w;
    }
    printf("  [ASSET] loaded 4 × %d BF16 weights from %s\n",
        $ANN_MODEL_THREAD_DEPTH, $MODEL_DIR) if $V;
}

sub flat_bf16 { my ($idx) = @_;
    return 0 if $idx < 0 || $idx >= 4*$ANN_MODEL_THREAD_DEPTH;
    my $t = int($idx / $ANN_MODEL_THREAD_DEPTH);
    my $o = $idx % $ANN_MODEL_THREAD_DEPTH;
    $weights[$t][$o] & 0xFFFF
}

sub l1_w  { my ($o,$i) = @_;
    ($o<0||$o>=$ANN_H1||$i<0||$i>=$ANN_N_FEAT) ? 0
        : flat_bf16($ANN_L1_W_OFF + $o*$ANN_N_FEAT + $i) }
sub l1_b  { my ($o) = @_;
    ($o<0||$o>=$ANN_H1) ? 0 : flat_bf16($ANN_L1_B_OFF + $o) }
sub l2_w  { my ($o,$i) = @_;
    ($o<0||$o>=$ANN_H2||$i<0||$i>=$ANN_H1) ? 0
        : flat_bf16($ANN_L2_W_OFF + $o*$ANN_H1 + $i) }
sub l2_b  { my ($o) = @_;
    ($o<0||$o>=$ANN_H2) ? 0 : flat_bf16($ANN_L2_B_OFF + $o) }
sub l3_w  { my ($o,$i) = @_;
    ($o<0||$o>=$ANN_N_CLASS||$i<0||$i>=$ANN_H2) ? 0
        : flat_bf16($ANN_L3_W_OFF + $o*$ANN_H2 + $i) }
sub l3_b  { my ($o) = @_;
    ($o<0||$o>=$ANN_N_CLASS) ? 0 : flat_bf16($ANN_L3_B_OFF + $o) }

# Per-bank GPU DMEM write (matches ann_hw_gpu_write in model_tb)
sub gpu_bank_write { my ($bank,$addr,$val) = @_;
    $gpu_bank[$bank][$addr] = $val & 0xFFFF }
sub gpu_bank_read  { my ($bank,$addr) = @_;
    my $v = $gpu_bank[$bank][$addr];
    defined($v) ? $v : 0 }

sub gpu_image_zero {
    for my $b (0..3) {
        for my $i (0..4095) { $gpu_bank[$b][$i] = 0 }
    }
}

# Weight packing — exact port of ann_hw_pack_l1/l2/l3
sub pack_l1 {
    for my $ot (0 .. ($ANN_H1/4 - 1)) {
        for my $kt (0 .. ($ANN_N_FEAT/4 - 1)) {
            my $tile_addr = $ANN_HW_GPU_W1_BASE + $ot*40 + $kt*4;
            for my $bank (0..3) {
                my $o = $ot*4 + $bank;
                for my $col (0..3) {
                    my $i = $kt*4 + $col;
                    gpu_bank_write($bank, $tile_addr + $col, l1_w($o, $i));
                }
            }
        }
        for my $bank (0..3) {
            my $o = $ot*4 + $bank;
            for my $col (0..3) {
                gpu_bank_write($bank, $ANN_HW_GPU_B1_BASE + $ot*4 + $col, l1_b($o));
            }
        }
    }
}
sub pack_l2 {
    for my $ot (0..10) {
        for my $kt (0..23) {
            my $tile_addr = $ANN_HW_GPU_W2_BASE + $ot*96 + $kt*4;
            for my $bank (0..3) {
                my $o = $ot*4 + $bank;
                for my $col (0..3) {
                    my $i = $kt*4 + $col;
                    gpu_bank_write($bank, $tile_addr + $col, l2_w($o, $i));
                }
            }
        }
        for my $bank (0..3) {
            my $o = $ot*4 + $bank;
            for my $col (0..3) {
                gpu_bank_write($bank, $ANN_HW_GPU_B2_BASE + $ot*4 + $col, l2_b($o));
            }
        }
    }
}
sub pack_l3 {
    for my $kt (0..10) {
        for my $bank (0..3) {
            my $o = $bank;
            for my $col (0..3) {
                my $i = $kt*4 + $col;
                gpu_bank_write($bank, $ANN_HW_GPU_W3_BASE + $kt*4 + $col, l3_w($o, $i));
            }
        }
    }
    for my $bank (0..3) {
        for my $col (0..3) {
            gpu_bank_write($bank, $ANN_HW_GPU_B3_BASE + $col, l3_b($bank));
        }
    }
}
sub build_gpu_image { gpu_image_zero(); pack_l1(); pack_l2(); pack_l3(); }

# GPU image → CPU DMEM packed word. Port of ann_hw_gpu_cpu_word.
sub gpu_cpu_word { my ($bf16_base,$words_per_bank,$flat_idx) = @_;
    my $bank = int($flat_idx / $words_per_bank);
    my $wsel = $flat_idx % $words_per_bank;
    my $lo = gpu_bank_read($bank & 3, $bf16_base + $wsel*2 + 0);
    my $hi = gpu_bank_read($bank & 3, $bf16_base + $wsel*2 + 1);
    pack2_u16($lo, $hi)
}

# Input pattern (host-generated, matches model_tb ann_input_pattern_bf16)
# or the real-row class demo. Returns BF16 u16.
sub input_bf16 { my ($feat,$pkt) = @_;
    if ($input_mode eq "classes") {
        die "class input pkt=$pkt feat=$feat out of range\n"
            if $pkt < 0 || $pkt > 3 || $feat < 0 || $feat >= $ANN_N_FEAT;
        return $CLASS_DEMO_INPUT_BF16[$pkt][$feat] & 0xFFFF;
    }
    my $pat = ($feat + $pkt) % 5;
    return 0xBF80 if $pat == 0;   # -1.0
    return 0xBF00 if $pat == 1;   # -0.5
    return 0x0000 if $pat == 2;
    return 0x3F00 if $pat == 3;   #  0.5
    return 0x3F80;                #  1.0
}
# ann_hw_input_cpu_word: packs two BF16 into a 32b CPU word.
sub input_cpu_word { my ($flat_idx) = @_;
    my $bank  = int($flat_idx / 20);
    my $wsel  = $flat_idx % 20;
    my $alo = $wsel*2;
    my $ahi = $wsel*2 + 1;
    my $flo = int($alo/4)*4 + $bank;
    my $fhi = int($ahi/4)*4 + $bank;
    my $vlo = input_bf16($flo, $alo % 4);
    my $vhi = input_bf16($fhi, $ahi % 4);
    pack2_u16($vlo, $vhi)
}

# ══════════════════════════════════════════════════════════════
#  ARM copy program (16-17 instrs, port of ann_hw_build_copy_prog)
# ══════════════════════════════════════════════════════════════
sub build_copy_prog {
    # v2.0: first instruction reads the per-thread CPU ID from CR10 into R11,
    # so the subsequent CMP/BNE gate runs thread 0 alone (HW has no backdoor).
    @copy_prog = ();
    push @copy_prog, arm_mrc(11, 10);        # 0  — R11 = CR10 = this thread's TID
    push @copy_prog, arm_cmp_imm(11, 0);     # 1  — CMP R11, #0
    push @copy_prog, 0;                       # 2  — patched to B.NE end (threads 1..3 halt)
    push @copy_prog, arm_mov_imm(1, 16);     # 3  — R1 = 16
    push @copy_prog, arm_mcr(1, 0);           # 4  — CR0 = 16 (src)
    push @copy_prog, arm_mov_imm(0, 0);      # 5  — R0 = 0
    push @copy_prog, arm_ldr_imm(2, 0, 0);   # 6  — R2 = mem[0] (dst)
    push @copy_prog, arm_ldr_imm(3, 0, 4);   # 7  — R3 = mem[1] (len)
    push @copy_prog, arm_mcr(2, 1);           # 8  — CR1 = dst
    push @copy_prog, arm_mcr(3, 2);           # 9  — CR2 = len
    push @copy_prog, arm_mov_imm(4, 65);     # 10 — R4 = 0x41 (D_UNPACK burst_all)
    push @copy_prog, arm_mcr(4, 3);           # 11 — CR3 = op → kick DMA
    push @copy_prog, arm_mov_shift(6, 3, $SHIFT_LSL, 2); # 12 — R6 = R3<<2
    push @copy_prog, arm_add_imm(6, 6, 16);  # 13 — R6 += 16 (wait target)
    push @copy_prog, arm_mrc(5, 9);           # 14 — R5 = CR9 (dma_cur_addr)
    push @copy_prog, arm_cmp_reg(5, 6);       # 15
    push @copy_prog, arm_b_idx(0x1, 16, 14); # 16 — B.NE back to MRC
    push @copy_prog, $HALT;                   # 17
    push @copy_prog, $HALT;                   # 18
    $copy_prog_len = scalar @copy_prog;
    $copy_prog[2] = arm_b_idx(0x1, 2, $copy_prog_len - 2);  # gate-by-thread (shifted)
    push @copy_prog, $NOP if $copy_prog_len % 2;   # pad to even
    $copy_prog_len = scalar @copy_prog;
}

# ══════════════════════════════════════════════════════════════
#  GPU program (60 instrs, port of ann_hw_build_gpu_prog)
# ══════════════════════════════════════════════════════════════
sub build_gpu_prog {
    @gpu_prog = ();
    # Linear kernel @ 0
    push @gpu_prog, enc_movi_dt(0, 0, $ANN_HW_GPU_PARAM_BASE);    # 0
    push @gpu_prog, enc_i($OP_LD, 0, 1, 0, 0);                     # 1
    push @gpu_prog, enc_i($OP_LD, 0, 2, 0, 1);                     # 2
    push @gpu_prog, enc_i($OP_LD, 0, 3, 0, 2);                     # 3
    push @gpu_prog, enc_i($OP_LD, 0, 0, 0, 3);                     # 4
    push @gpu_prog, 0;                                              # 5
    push @gpu_prog, 0;                                              # 6
    push @gpu_prog, enc_wmma_load(0, 4,  1, 0);                    # 7
    push @gpu_prog, enc_wmma_load(1, 8,  2, 0);                    # 8
    push @gpu_prog, enc_wmma_load(2, 12, 3, 0);                    # 9
    push @gpu_prog, enc_movi_dt(0, 3, 0);                           # 10
    push @gpu_prog, enc_wmma_mma(12, 4, 8, 12);                    # 11
    push @gpu_prog, enc_i($OP_ADDI, 0, 0, 0, 0xFFFF);              # 12
    push @gpu_prog, enc_setp(0, $COMP_NE, 0, 0, 3);                # 13
    push @gpu_prog, 0;                                              # 14
    push @gpu_prog, enc_pbra(0, 17, 16);                           # 15
    push @gpu_prog, enc_bra(23);                                   # 16
    push @gpu_prog, enc_i($OP_ADDI, 0, 1, 1, 4);                  # 17
    push @gpu_prog, enc_i($OP_ADDI, 0, 2, 2, 4);                  # 18
    push @gpu_prog, enc_wmma_load(0, 4, 1, 0);                    # 19
    push @gpu_prog, enc_wmma_load(1, 8, 2, 0);                    # 20
    push @gpu_prog, enc_wmma_mma(12, 4, 8, 12);                  # 21
    push @gpu_prog, enc_bra(12);                                   # 22
    push @gpu_prog, enc_movi_dt(0, 0, $ANN_HW_GPU_PARAM_BASE);   # 23
    push @gpu_prog, enc_i($OP_LD, 0, 1, 0, 4);                    # 24
    push @gpu_prog, 0;                                              # 25
    push @gpu_prog, enc_wmma_store(12, 1, 0);                     # 26
    push @gpu_prog, (($OP_RET & 0x1F) << 27);                     # 27
    # ReLU kernel @ 28
    push @gpu_prog, enc_movi_dt(0, 0, $ANN_HW_GPU_PARAM_BASE);   # 28
    push @gpu_prog, enc_i($OP_LD, 0, 1, 0, 0);                    # 29
    push @gpu_prog, enc_i($OP_LD, 0, 2, 0, 1);                    # 30
    push @gpu_prog, enc_i($OP_LD, 0, 3, 0, 2);                    # 31
    push @gpu_prog, enc_i($OP_LD, 0, 0, 0, 3);                    # 32
    push @gpu_prog, 0;                                              # 33
    push @gpu_prog, 0;                                              # 34
    push @gpu_prog, enc_wmma_load(0, 4, 1, 0);                    # 35
    push @gpu_prog, enc_wmma_load(1, 8, 2, 0);                    # 36
    push @gpu_prog, enc_wmma_load(2, 12, 3, 0);                   # 37
    push @gpu_prog, enc_movi_dt(0, 3, 0);                           # 38
    push @gpu_prog, enc_wmma_mma(12, 4, 8, 12);                  # 39
    push @gpu_prog, enc_i($OP_ADDI, 0, 0, 0, 0xFFFF);             # 40
    push @gpu_prog, enc_setp(0, $COMP_NE, 0, 0, 3);               # 41
    push @gpu_prog, 0;                                              # 42
    push @gpu_prog, enc_pbra(0, 45, 44);                          # 43
    push @gpu_prog, enc_bra(51);                                   # 44
    push @gpu_prog, enc_i($OP_ADDI, 0, 1, 1, 4);                  # 45
    push @gpu_prog, enc_i($OP_ADDI, 0, 2, 2, 4);                  # 46
    push @gpu_prog, enc_wmma_load(0, 4, 1, 0);                    # 47
    push @gpu_prog, enc_wmma_load(1, 8, 2, 0);                    # 48
    push @gpu_prog, enc_wmma_mma(12, 4, 8, 12);                  # 49
    push @gpu_prog, enc_bra(40);                                   # 50
    push @gpu_prog, enc_r($OP_MAX, 1, 12, 12, 3);                 # 51
    push @gpu_prog, enc_r($OP_MAX, 1, 13, 13, 3);                 # 52
    push @gpu_prog, enc_r($OP_MAX, 1, 14, 14, 3);                 # 53
    push @gpu_prog, enc_r($OP_MAX, 1, 15, 15, 3);                 # 54
    push @gpu_prog, enc_movi_dt(0, 0, $ANN_HW_GPU_PARAM_BASE);   # 55
    push @gpu_prog, enc_i($OP_LD, 0, 1, 0, 4);                    # 56
    push @gpu_prog, 0;                                              # 57
    push @gpu_prog, enc_wmma_store(12, 1, 0);                     # 58
    push @gpu_prog, (($OP_RET & 0x1F) << 27);                     # 59
    $gpu_prog_len = scalar @gpu_prog;
}

# ══════════════════════════════════════════════════════════════
#  Scheduler records builder (writes into @final_dmem)
# ══════════════════════════════════════════════════════════════
sub write_sched_record {
    my ($rec_idx, $entry_pc, $a_base, $b_base, $c_base, $k_count, $out_base) = @_;
    my $base = $ANN_HW_SCHED_CPU_BASE + $rec_idx * $ANN_HW_SCHED_RECORD_WORDS;
    my $word0 = pack2_u16($a_base, $b_base);
    my $word1 = pack2_u16($c_base, $k_count);
    my $word2 = pack2_u16($out_base, 0);
    $final_dmem[$base + 0] = $entry_pc;
    for my $bank (0..3) {
        $final_dmem[$base + 1 + $bank*3 + 0] = $word0;
        $final_dmem[$base + 1 + $bank*3 + 1] = $word1;
        $final_dmem[$base + 1 + $bank*3 + 2] = $word2;
    }
}

sub build_sched_and_final_dmem {
    @sched_prog = ();
    @final_dmem = (0) x 1024;
    $final_dmem[0]  = $ANN_HW_DMA_WAIT_PARAM;
    $final_dmem[1]  = $ANN_HW_DMA_WAIT_INPUT;
    $final_dmem[2]  = $ANN_HW_DMA_WAIT_GPU;
    $final_dmem[3]  = $ANN_HW_GPUK_CPU_BASE;
    $final_dmem[4]  = $ANN_HW_INPUT_CPU_BASE;
    $final_dmem[5]  = $ANN_HW_SCHED_CPU_BASE * 4;
    $final_dmem[6]  = $ANN_HW_READBACK_CPU_BASE;
    $final_dmem[7]  = $ANN_HW_GPU_PARAM_BASE;
    $final_dmem[8]  = $ANN_HW_GPU_X0_BASE;
    $final_dmem[9]  = $ANN_HW_GPU_X3_BASE;
    $final_dmem[10] = $gpu_prog_len;
    $final_dmem[11] = 20;
    $final_dmem[12] = 3;
    $final_dmem[13] = 2;
    $final_dmem[14] = $ANN_HW_SCHED_RECORD_WORDS;
    $final_dmem[15] = $ANN_HW_TILE_COUNT;
    for my $i (0 .. $gpu_prog_len - 1) {
        $final_dmem[$ANN_HW_GPUK_CPU_BASE + $i] = $gpu_prog[$i];
    }
    for my $i (0..79) {
        $final_dmem[$ANN_HW_INPUT_CPU_BASE + $i] = input_cpu_word($i);
    }

    my $rec = 0;
    for my $ot (0..23) {
        write_sched_record($rec++, $ANN_HW_GPU_RELU_PC,
            $ANN_HW_GPU_W1_BASE + $ot*40,
            $ANN_HW_GPU_X0_BASE,
            $ANN_HW_GPU_B1_BASE + $ot*4,
            10,
            $ANN_HW_GPU_X1_BASE + $ot*4);
    }
    for my $ot (0..10) {
        write_sched_record($rec++, $ANN_HW_GPU_RELU_PC,
            $ANN_HW_GPU_W2_BASE + $ot*96,
            $ANN_HW_GPU_X1_BASE,
            $ANN_HW_GPU_B2_BASE + $ot*4,
            24,
            $ANN_HW_GPU_X2_BASE + $ot*4);
    }
    write_sched_record($rec++, $ANN_HW_GPU_LINEAR_PC,
        $ANN_HW_GPU_W3_BASE,
        $ANN_HW_GPU_X2_BASE,
        $ANN_HW_GPU_B3_BASE,
        11,
        $ANN_HW_GPU_X3_BASE);

    $final_dmem_words = $ANN_HW_READBACK_CPU_BASE + 8;

    # Sched program (port of ann_hw_build_sched_prog, v2.0 — CR10 TID gate)
    push @sched_prog, arm_mrc(11, 10);                    # 0 — R11 = per-thread TID
    push @sched_prog, arm_cmp_imm(11, 0);                 # 1
    push @sched_prog, 0;                                    # 2 patched — B.NE halt
    push @sched_prog, arm_mov_imm(0, 0);                   # 2
    push @sched_prog, arm_ldr_imm(1, 0, 12);               # 3
    push @sched_prog, arm_mcr(1, 0);                        # 4
    push @sched_prog, arm_mov_imm(2, 0);                   # 5
    push @sched_prog, arm_mcr(2, 1);                        # 6
    push @sched_prog, arm_ldr_imm(2, 0, 40);               # 7
    push @sched_prog, arm_mcr(2, 2);                        # 8
    push @sched_prog, arm_mov_imm(3, 5);                   # 9
    push @sched_prog, arm_mcr(3, 3);                        # 10
    push @sched_prog, arm_ldr_imm(6, 0, 12);               # 11
    push @sched_prog, arm_add_reg(6, 6, 2);                # 12
    push @sched_prog, arm_mrc(5, 9);                        # 13
    push @sched_prog, arm_cmp_reg(5, 6);                    # 14
    push @sched_prog, arm_b_idx(0x1, 16, 14);               # 16
    push @sched_prog, arm_ldr_imm(1, 0, 16);               # 16
    push @sched_prog, arm_mcr(1, 0);                        # 17
    push @sched_prog, arm_ldr_imm(2, 0, 32);               # 18
    push @sched_prog, arm_mcr(2, 1);                        # 19
    push @sched_prog, arm_ldr_imm(2, 0, 44);               # 20
    push @sched_prog, arm_mcr(2, 2);                        # 21
    push @sched_prog, arm_mov_imm(3, 65);                  # 22
    push @sched_prog, arm_mcr(3, 3);                        # 23
    push @sched_prog, arm_mov_shift(6, 2, $SHIFT_LSL, 2); # 24
    push @sched_prog, arm_add_reg(6, 6, 1);                # 25
    push @sched_prog, arm_mrc(5, 9);                        # 26
    push @sched_prog, arm_cmp_reg(5, 6);                    # 27
    push @sched_prog, arm_b_idx(0x1, 29, 27);               # 29
    push @sched_prog, arm_mov_imm(1, 15);                  # 29
    push @sched_prog, arm_mcr(1, 7);                        # 30
    push @sched_prog, arm_ldr_imm(5, 0, 20);               # 31
    push @sched_prog, arm_ldr_imm(6, 0, 60);               # 32
    push @sched_prog, arm_ldr_imm(1, 5, 0);                # 33
    push @sched_prog, arm_mcr(1, 4);                        # 34
    push @sched_prog, arm_mov_shift(4, 5, $SHIFT_LSR, 2); # 35
    push @sched_prog, arm_add_imm(1, 4, 1);                # 36
    push @sched_prog, arm_mcr(1, 0);                        # 37
    push @sched_prog, arm_ldr_imm(2, 0, 28);               # 38
    push @sched_prog, arm_mcr(2, 1);                        # 39
    push @sched_prog, arm_ldr_imm(2, 0, 48);               # 40
    push @sched_prog, arm_mcr(2, 2);                        # 41
    push @sched_prog, arm_mov_imm(3, 65);                  # 42
    push @sched_prog, arm_mcr(3, 3);                        # 43
    push @sched_prog, arm_mov_shift(7, 2, $SHIFT_LSL, 2); # 44
    push @sched_prog, arm_add_reg(7, 7, 1);                # 45
    push @sched_prog, arm_mrc(12, 9);                       # 46
    push @sched_prog, arm_cmp_reg(12, 7);                   # 47
    push @sched_prog, arm_b_idx(0x1, 49, 47);               # 49
    push @sched_prog, arm_mov_imm(2, 1);                   # 49
    push @sched_prog, arm_mcr(2, 5);                        # 50
    push @sched_prog, arm_mrc(12, 6);                       # 51
    push @sched_prog, arm_cmp_imm(12, 5);                   # 52
    push @sched_prog, arm_b_idx(0x1, 54, 52);               # 54
    push @sched_prog, arm_add_imm(5, 5, 52);               # 54
    push @sched_prog, arm_sub_imm(6, 6, 1);                # 55
    push @sched_prog, arm_cmp_imm(6, 0);                    # 56
    push @sched_prog, arm_b_idx(0x1, 58, 34);               # 58
    push @sched_prog, arm_ldr_imm(1, 0, 36);               # 58
    push @sched_prog, arm_mcr(1, 0);                        # 59
    push @sched_prog, arm_ldr_imm(2, 0, 24);               # 60
    push @sched_prog, arm_mcr(2, 1);                        # 61
    push @sched_prog, arm_ldr_imm(2, 0, 52);               # 62
    push @sched_prog, arm_mcr(2, 2);                        # 63
    push @sched_prog, arm_mov_imm(3, 67);                  # 64
    push @sched_prog, arm_mcr(3, 3);                        # 65
    push @sched_prog, arm_mov_shift(7, 2, $SHIFT_LSL, 2); # 66
    push @sched_prog, arm_ldr_imm(1, 0, 24);               # 67
    push @sched_prog, arm_add_reg(7, 7, 1);                # 68
    push @sched_prog, arm_mrc(12, 9);                       # 69
    push @sched_prog, arm_cmp_reg(12, 7);                   # 70
    push @sched_prog, arm_b_idx(0x1, 72, 70);               # 72
    # Post-process logits (72..112)
    push @sched_prog, arm_mov_shift(0, 1, $SHIFT_LSL, 2); # 72
    for my $k (0..7) {
        push @sched_prog, arm_ldr_imm(4+$k, 0, $k*4);      # 73..80
    }
    push @sched_prog, arm_mov_shift(12, 4,  $SHIFT_LSL, 16); # 81
    push @sched_prog, arm_mov_shift(12, 12, $SHIFT_LSR, 16); # 82
    push @sched_prog, arm_orr_shift(12, 12, 6, $SHIFT_LSL, 16); # 83
    push @sched_prog, arm_str_imm(12, 0, 0);                  # 84
    push @sched_prog, arm_mov_shift(12, 8,  $SHIFT_LSL, 16); # 85
    push @sched_prog, arm_mov_shift(12, 12, $SHIFT_LSR, 16); # 86
    push @sched_prog, arm_orr_shift(12, 12, 10, $SHIFT_LSL, 16); # 87
    push @sched_prog, arm_str_imm(12, 0, 4);                  # 88
    push @sched_prog, arm_mov_shift(12, 4,  $SHIFT_LSR, 16); # 89
    push @sched_prog, arm_mov_shift(14, 6,  $SHIFT_LSR, 16); # 90
    push @sched_prog, arm_orr_shift(12, 12, 14, $SHIFT_LSL, 16); # 91
    push @sched_prog, arm_str_imm(12, 0, 8);                  # 92
    push @sched_prog, arm_mov_shift(12, 8,  $SHIFT_LSR, 16); # 93
    push @sched_prog, arm_mov_shift(14, 10, $SHIFT_LSR, 16); # 94
    push @sched_prog, arm_orr_shift(12, 12, 14, $SHIFT_LSL, 16); # 95
    push @sched_prog, arm_str_imm(12, 0, 12);                 # 96
    push @sched_prog, arm_mov_shift(12, 5,  $SHIFT_LSL, 16); # 97
    push @sched_prog, arm_mov_shift(12, 12, $SHIFT_LSR, 16); # 98
    push @sched_prog, arm_orr_shift(12, 12, 7, $SHIFT_LSL, 16); # 99
    push @sched_prog, arm_str_imm(12, 0, 16);                 # 100
    push @sched_prog, arm_mov_shift(12, 9,  $SHIFT_LSL, 16); # 101
    push @sched_prog, arm_mov_shift(12, 12, $SHIFT_LSR, 16); # 102
    push @sched_prog, arm_orr_shift(12, 12, 11, $SHIFT_LSL, 16); # 103
    push @sched_prog, arm_str_imm(12, 0, 20);                 # 104
    push @sched_prog, arm_mov_shift(12, 5,  $SHIFT_LSR, 16); # 105
    push @sched_prog, arm_mov_shift(14, 7,  $SHIFT_LSR, 16); # 106
    push @sched_prog, arm_orr_shift(12, 12, 14, $SHIFT_LSL, 16); # 107
    push @sched_prog, arm_str_imm(12, 0, 24);                 # 108
    push @sched_prog, arm_mov_shift(12, 9,  $SHIFT_LSR, 16); # 109
    push @sched_prog, arm_mov_shift(14, 11, $SHIFT_LSR, 16); # 110
    push @sched_prog, arm_orr_shift(12, 12, 14, $SHIFT_LSL, 16); # 111
    push @sched_prog, arm_str_imm(12, 0, 28);                 # 112

    push @sched_prog, $HALT;  # 113
    push @sched_prog, $HALT;  # 114
    $sched_prog_len = scalar @sched_prog;
    $sched_prog[2] = arm_b_idx(0x1, 2, $sched_prog_len - 2);
    push @sched_prog, $NOP if $sched_prog_len % 2;
    $sched_prog_len = scalar @sched_prog;
}

# ══════════════════════════════════════════════════════════════
#  Packet-level helpers (chunked, stay within MMIO scratch limit)
# ══════════════════════════════════════════════════════════════

# Send one LOAD_DMEM packet with `@data` 32b words starting at word `addr`.
# Count in DWs = ceil(n/2). Pads with NOP if odd. Returns after drain.
sub pkt_load_dmem {
    my ($addr, $words_ref, $off, $n_words, $ctrl) = @_;
    $ctrl = 0x20 unless defined $ctrl;
    my $dw_count = int(($n_words + 1) / 2);
    my @c = cw(2, $addr, $dw_count, 0);
    iw($c[0], $c[1], $ctrl);
    for (my $i = 0; $i < $n_words; $i += 2) {
        my $lo = $words_ref->[$off + $i] & 0xFFFFFFFF;
        my $hi = (($i + 1) < $n_words ? $words_ref->[$off + $i + 1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    id();
}

sub pkt_load_imem {
    my ($addr, $words_ref, $off, $n_words, $ctrl) = @_;
    $ctrl = 0x20 unless defined $ctrl;
    my $dw_count = int(($n_words + 1) / 2);
    my @c = cw(1, $addr, $dw_count, 0);
    iw($c[0], $c[1], $ctrl);
    for (my $i = 0; $i < $n_words; $i += 2) {
        my $lo = $words_ref->[$off + $i] & 0xFFFFFFFF;
        my $hi = (($i + 1) < $n_words ? $words_ref->[$off + $i + 1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    id();
}

# Split a large 32b-word array into multiple LOAD_DMEM packets.
sub send_dmem_chunked {
    my ($start_addr, $words_ref, $label) = @_;
    my $n = scalar @$words_ref;
    my $words_per_pkt = 2 * $CHUNK_DW;   # each DW = 2 words
    my $off = 0; my $pkt = 0;
    while ($off < $n) {
        my $chunk = ($n - $off > $words_per_pkt) ? $words_per_pkt : ($n - $off);
        ic();
        pkt_load_dmem($start_addr + $off, $words_ref, $off, $chunk, 0x20);
        $off += $chunk; $pkt++;
    }
    printf("  [CHUNKED] %s: %d words over %d packets\n", $label, $n, $pkt) if $V;
}

sub send_imem_chunked {
    my ($start_addr, $words_ref, $label) = @_;
    my $n = scalar @$words_ref;
    my $words_per_pkt = 2 * $CHUNK_DW;
    my $off = 0; my $pkt = 0;
    while ($off < $n) {
        my $chunk = ($n - $off > $words_per_pkt) ? $words_per_pkt : ($n - $off);
        ic();
        pkt_load_imem($start_addr + $off, $words_ref, $off, $chunk, 0x20);
        $off += $chunk; $pkt++;
    }
    printf("  [CHUNKED] %s: %d instrs over %d packets\n", $label, $n, $pkt) if $V;
}

# Packet: send copy_consts (2 DWs) and one weight chunk's 32b words
# all in one go (if small enough) or split.
# Returns the CPU DMEM address immediately after the last written word.
sub send_copy_consts_pkt {
    my ($gpu_dst, $words_per_bank, $wait_count) = @_;
    # CPU DMEM[0] = gpu_dst, [1] = words_per_bank, [2] = wait_count, [3] = 0.
    # model_tb: rx({{16'h0, words_per_bank}, {16'h0, gpu_dst}}) → HI=wpb, LO=gpu_dst.
    ic();
    my @c = cw(2, 0, 2, 0); iw($c[0], $c[1], 0x20);
    iw($words_per_bank & 0xFFFF, $gpu_dst & 0xFFFF, 0);     # word1 | word0
    iw(0, $wait_count & 0xFFFFFFFF, 0);                      # word3 | word2
    id();
}

# Send a weight chunk to CPU DMEM[16..16+2*wpb-1] (= 2*wpb 32b words).
# bf16_base = starting BF16 index within each bank image.
sub send_weight_chunk {
    my ($bf16_base, $words_per_bank) = @_;
    my $total_words = 4 * $words_per_bank;    # 4 banks × wpb 32b words (each covers 2 bf16)
    my @words;
    for (my $flat = 0; $flat < $total_words; $flat++) {
        push @words, gpu_cpu_word($bf16_base, $words_per_bank, $flat);
    }
    send_dmem_chunked($ANN_HW_COPY_BUF_BASE, \@words,
                      sprintf("weight_chunk bf16_base=%d wpb=%d", $bf16_base, $words_per_bank));
}

# Issue CPU_START (one small packet), wait for drd+txd.
sub pkt_cpu_start {
    ic();
    my @c = cw(3, 0, 0, 0); iw($c[0], $c[1], 0x20);
    # pkt_proc will wait for cpu_done before returning to IDLE.
    # Use larger poll budget for long-running CPU programs.
    id();
    # No TX expected (no SEND_PKT). drd is enough.
}

# Final packet: CPU_START + READBACK + SEND_PKT (triggers inference + reads out Y)
sub pkt_final_run {
    ic();
    my @c;
    @c = cw(3, 0, 0, 0);                                                    iw($c[0], $c[1], 0x20);
    @c = cw(4, $ANN_HW_READBACK_CPU_BASE, 4, 0);                            iw($c[0], $c[1], 0x00);
    @c = cw(5, 0, 0, 0);                                                    iw($c[0], $c[1], 0x00);
    id();
    # Poll budget: 5 minutes. HW inference is ~80k cycles of real compute,
    # but pkt_proc also has to clock through CPU halt detection + RB + SEND_PKT,
    # and if the scheduler is stepping on itself (known 4-thread concern, see
    # BLOCKER note below), it may still be alive and slowly making progress.
    my $done = pt(3000, 100);
    dump_st("post-poll");
    return ($done, cr());
}

# ══════════════════════════════════════════════════════════════
#  Main flow — split into LOAD (weights → GPU DMEM) and RUN (inference)
#  GPU DMEM is BRAM and retains contents across ic()/hard_reset(),
#  so `load` once and `run` as many times as you like.
# ══════════════════════════════════════════════════════════════

sub ann_build_host {
    phase("Host-side asset build");
    load_weights();
    build_gpu_image();
    build_copy_prog();
    build_gpu_prog();
    build_sched_and_final_dmem();
    printf("  [BUILD] copy_prog=%d instrs  gpu_prog=%d instrs  sched_prog=%d instrs\n",
        $copy_prog_len, $gpu_prog_len, $sched_prog_len);
    printf("  [BUILD] final_dmem_words=%d  preload0=%d/bank  preload1=%d/bank\n",
        $final_dmem_words, $ANN_HW_PRELOAD0_WPB, $ANN_HW_PRELOAD1_WPB);
    printf("  [BUILD] input_mode=%s\n", $input_mode);
}

# Stage 1: push all ANN weights into GPU DMEM via the on-SoC DMA copy path.
# After this completes, GPU DMEM[0..2121] per bank holds the packed weight
# image and survives until the bitfile is reloaded.
sub ann_load_weights {
    banner("T_ANN_LOAD: stream 4×2048 BF16 weights into GPU DMEM");
    ann_build_host();
    hard_reset();

    phase("CPU IMEM ← copy program");
    send_imem_chunked(0, \@copy_prog, "copy_prog");

    phase("Weight chunk 0 (dst=0, wpb=$ANN_HW_PRELOAD0_WPB)");
    send_copy_consts_pkt(0, $ANN_HW_PRELOAD0_WPB, $ANN_HW_DMA_WAIT_COPY_LONG);
    send_weight_chunk(0, $ANN_HW_PRELOAD0_WPB);
    phase("CPU_START 1 (copy → GPU DMEM[0..1019] per bank)");
    pkt_cpu_start();

    phase("Weight chunk 1 (dst=$ANN_HW_PRELOAD1_GPU_BASE, wpb=$ANN_HW_PRELOAD1_WPB)");
    send_copy_consts_pkt($ANN_HW_PRELOAD1_GPU_BASE, $ANN_HW_PRELOAD1_WPB,
                         $ANN_HW_DMA_WAIT_COPY_SHORT);
    send_weight_chunk($ANN_HW_PRELOAD1_GPU_BASE, $ANN_HW_PRELOAD1_WPB);
    phase("CPU_START 2 (copy → GPU DMEM[2040..2121] per bank)");
    pkt_cpu_start();

    dump_st("after-load");
    print "  [OK] weights resident in GPU DMEM — run `model_test run` to infer\n\n";
}

# ══════════════════════════════════════════════════════════════
#  Host-driven tiled run (36 consolidated tiles)
#
#  Replaces model_tb's CPU-side scheduler (which requires a sim-only
#  per-thread regfile poke to gate 3 of the 4 threads). Here the Perl
#  host drives the outer 36-tile loop and each per-tile ARM is a
#  straight-line program (DMA → GPU launch → DMA → halt) — same
#  structure as copy_prog, which we confirmed works safely when all
#  4 threads race through it (redundant DMA/GPU kicks are no-ops
#  while the engine is busy).
#
#  Layout (CPU DMEM, 32-bit words):
#    [ 0.. 11] per-tile DMA params (3 words × 4 banks, D_UNPACK burst_all)
#    [12]     GPU_PARAM_BASE = 2208 (constant for tile_arm LDR)
#    [13]     entry_pc  (0 = LINEAR kernel, 28 = RELU kernel)
#    [14]     DMA wait target for input copy = 12
#    [15]     GPU done value = 5  (CR6: {idle, active, done} = 0b101)
#    [16..23] readback scratch (D_PACK result during final packet)
#
#  tile_arm (stays resident in CPU IMEM after tile_setup):
#    1. D_UNPACK CPU[0..11] → GPU[GPU_PARAM_BASE..] (3 words/bank × 4, burst)
#    2. wait CR9 == 12
#    3. launch GPU at entry_pc with mask=0xF
#    4. wait CR6 == 5
#    5. halt
# ══════════════════════════════════════════════════════════════

# Constants for tile scratch area
my $TILE_CPU_PARAM_BASE = 0;       # word 0: DMA params start
my $TILE_CPU_GPU_PBASE  = 12;      # word 12: GPU_PARAM_BASE constant
my $TILE_CPU_ENTRY_PC   = 13;      # word 13: entry_pc
my $TILE_CPU_WAIT_DMA   = 14;      # word 14: DMA wait target (12)
my $TILE_CPU_WAIT_GPU   = 15;      # word 15: GPU done value (5)
my $TILE_CPU_RB_BASE    = 16;      # word 16..23: readback scratch

# Build the one-time GPU-program-loader ARM. It DMAs CPU DMEM[0..2*gpu_prog_len-1]
# (where GPU prog instructions live as 32b words) into GPU IMEM via D_IMEM,
# then halts.
sub build_gpu_imem_loader {
    my @p;
    push @p, arm_mov_imm(0, 0);              # R0 = 0 (CPU DMEM base)
    push @p, arm_mov_imm(1, 0);              # R1 = 0 (DMA src)
    push @p, arm_mcr(1, 0);                   # CR0 = 0
    push @p, arm_mov_imm(1, 0);              # R1 = 0 (DMA dst in GPU IMEM)
    push @p, arm_mcr(1, 1);                   # CR1 = 0
    push @p, arm_mov_imm(1, $gpu_prog_len);  # R1 = gpu_prog_len (60)
    push @p, arm_mcr(1, 2);                   # CR2 = 60 (len)
    push @p, arm_mov_imm(1, 5);              # R1 = 5 (D_IMEM opcode)
    push @p, arm_mcr(1, 3);                   # CR3 = 5 → kick D_IMEM
    # wait: CR9 == 0 + 60 = 60 (D_IMEM advances cpu_ptr by 1 per instr)
    my $wait_loop = scalar @p;
    push @p, arm_mrc(5, 9);                   # R5 = CR9
    push @p, arm_mov_imm(6, $gpu_prog_len);  # R6 = 60
    push @p, arm_cmp_reg(5, 6);
    push @p, arm_b_idx(0x1, scalar(@p), $wait_loop);  # B.NE loop
    push @p, $HALT;
    push @p, $NOP while @p % 2;
    return \@p;
}

# Build the tile ARM (re-used for all 36 tiles). Reads params pre-staged in
# CPU DMEM by the host (see layout above). Straight-line single-pass program.
sub build_tile_arm {
    my @p;
    # Phase 1: D_UNPACK CPU[0..11] → GPU_PARAM_BASE (3 words/bank × 4 banks, burst_all)
    push @p, arm_mov_imm(0, 0);                               # R0 = 0
    push @p, arm_mov_imm(1, 0);                               # R1 = 0 (DMA src)
    push @p, arm_mcr(1, 0);                                    # CR0 = 0
    push @p, arm_ldr_imm(1, 0, $TILE_CPU_GPU_PBASE * 4);     # R1 = mem[12] = GPU_PARAM_BASE
    push @p, arm_mcr(1, 1);                                    # CR1 = GPU_PARAM_BASE
    push @p, arm_mov_imm(1, 3);                               # R1 = 3 (len: 3 words/bank)
    push @p, arm_mcr(1, 2);                                    # CR2 = 3
    push @p, arm_mov_imm(1, 0x41);                            # R1 = 0x41 (D_UNPACK burst_all)
    push @p, arm_mcr(1, 3);                                    # CR3 = 0x41 → kick
    # Wait: CR9 == 12  (src=0, len=3, burst_all=4 banks → cpu_ptr ends at 12)
    my $wait_dma = scalar @p;
    push @p, arm_mrc(5, 9);                                    # R5 = CR9
    push @p, arm_ldr_imm(6, 0, $TILE_CPU_WAIT_DMA * 4);       # R6 = mem[14] = 12
    push @p, arm_cmp_reg(5, 6);
    push @p, arm_b_idx(0x1, scalar(@p), $wait_dma);

    # Phase 2: Launch GPU at entry_pc with mask=0xF
    push @p, arm_ldr_imm(1, 0, $TILE_CPU_ENTRY_PC * 4);       # R1 = entry_pc
    push @p, arm_mcr(1, 4);                                    # CR4 = entry_pc
    push @p, arm_mov_imm(1, 15);                              # R1 = 15 (mask)
    push @p, arm_mcr(1, 7);                                    # CR7 = 15
    push @p, arm_mov_imm(1, 1);                               # R1 = 1 (start)
    push @p, arm_mcr(1, 5);                                    # CR5 = 1 → kick GPU
    # Wait: CR6 == 5  (idle | done, active=0)
    my $wait_gpu = scalar @p;
    push @p, arm_mrc(5, 6);                                    # R5 = CR6
    push @p, arm_ldr_imm(6, 0, $TILE_CPU_WAIT_GPU * 4);       # R6 = mem[15] = 5
    push @p, arm_cmp_reg(5, 6);
    push @p, arm_b_idx(0x1, scalar(@p), $wait_gpu);

    push @p, $HALT;
    push @p, $NOP while @p % 2;
    return \@p;
}

# Build the final D_PACK ARM. DMAs GPU[X3_BASE..X3_BASE+1 per bank, burst_all]
# → CPU DMEM[TILE_CPU_RB_BASE..]. 2 words/bank × 4 banks = 8 CPU words = 4 DWs.
sub build_dpack_arm {
    my @p;
    push @p, arm_mov_imm(0, 0);                               # R0 = 0
    push @p, arm_ldr_imm(1, 0, ($TILE_CPU_PARAM_BASE + 0) * 4); # R1 = mem[0] = X3_BASE GPU addr
    push @p, arm_mcr(1, 0);                                    # CR0 = X3_BASE (GPU src)
    push @p, arm_ldr_imm(1, 0, ($TILE_CPU_PARAM_BASE + 1) * 4); # R1 = mem[1] = CPU RB dst
    push @p, arm_mcr(1, 1);                                    # CR1 = CPU RB addr
    push @p, arm_mov_imm(1, 2);                               # R1 = 2 (len: 2 32b words/bank)
    push @p, arm_mcr(1, 2);                                    # CR2 = 2
    push @p, arm_mov_imm(1, 0x43);                            # R1 = 0x43 (D_PACK burst_all)
    push @p, arm_mcr(1, 3);                                    # CR3 → kick D_PACK
    # Wait: CR9 == RB + 2*4 = RB + 8  (D_PACK advances cpu_ptr by 1 per 32b word written)
    my $wait_dma = scalar @p;
    push @p, arm_mrc(5, 9);
    push @p, arm_ldr_imm(6, 0, ($TILE_CPU_PARAM_BASE + 2) * 4); # R6 = mem[2] = wait target
    push @p, arm_cmp_reg(5, 6);
    push @p, arm_b_idx(0x1, scalar(@p), $wait_dma);
    push @p, $HALT;
    push @p, $NOP while @p % 2;
    return \@p;
}

# Load GPU program into GPU IMEM via a one-time CPU-side DMA.
sub gpu_prog_load {
    # Step 1: stage GPU prog in CPU DMEM[0..gpu_prog_len-1]
    ic();
    my $dw = int(($gpu_prog_len + 1) / 2);
    my @c = cw(2, 0, $dw, 0); iw($c[0], $c[1], 0x20);
    for (my $i = 0; $i < $gpu_prog_len; $i += 2) {
        my $lo = $gpu_prog[$i] & 0xFFFFFFFF;
        my $hi = (($i+1) < $gpu_prog_len ? $gpu_prog[$i+1] : 0) & 0xFFFFFFFF;
        iw($hi, $lo, 0);
    }
    id();

    # Step 2: push the GPU-IMEM-loader ARM into CPU IMEM
    my $loader = build_gpu_imem_loader();
    ic();
    pkt_load_imem(0, $loader, 0, scalar(@$loader), 0x20);

    # Step 3: CPU_START. pkt_proc enters P_CPU_RUN, CPU DMAs GPU prog
    # into GPU IMEM via D_IMEM, halts. drd fires when pkt_proc returns to IDLE.
    ic();
    @c = cw(3, 0, 0, 0); iw($c[0], $c[1], 0x20);
    id();
    printf("  [GPU_PROG] loaded %d instructions into GPU IMEM\n", $gpu_prog_len) if $V;
}

# Install the per-tile ARM into CPU IMEM once; reused across all 36 tiles.
sub tile_arm_install {
    my $arm = build_tile_arm();
    ic();
    pkt_load_imem(0, $arm, 0, scalar(@$arm), 0x20);
    id();
    printf("  [TILE_ARM] installed (%d instructions)\n", scalar(@$arm)) if $V;
}

# Run one tile. Params are read from @final_dmem (built by
# build_sched_and_final_dmem in ann_build_host).
sub run_one_tile {
    my ($tile_idx) = @_;
    my $rec = $ANN_HW_SCHED_CPU_BASE + $tile_idx * $ANN_HW_SCHED_RECORD_WORDS;
    my $entry_pc = $final_dmem[$rec + 0];
    # Per-bank 3-word records sit at $rec+1 .. $rec+12 (same for all 4 banks).

    # Stage tile params in CPU DMEM[0..15]:
    #   [0..11] = 4 × (3 per-bank words) for D_UNPACK burst_all
    #   [12]    = GPU_PARAM_BASE
    #   [13]    = entry_pc
    #   [14]    = DMA wait target (12)
    #   [15]    = GPU done value (5)
    my @words;
    for my $bank (0..3) {
        for my $i (0..2) {
            push @words, $final_dmem[$rec + 1 + $bank*3 + $i];
        }
    }
    push @words, $ANN_HW_GPU_PARAM_BASE;   # [12]
    push @words, $entry_pc;                  # [13]
    push @words, 12;                         # [14]
    push @words, 5;                          # [15]

    ic();
    # Same packet:
    #   LOAD_DMEM addr=0 count=8 (16 words = 8 DWs)
    #   CPU_START  +  READBACK (dummy 4 DWs from RB area) + SEND_PKT
    my @c;
    @c = cw(2, 0, 8, 0); iw($c[0], $c[1], 0x20);
    for (my $i = 0; $i < 16; $i += 2) {
        iw($words[$i+1] & 0xFFFFFFFF, $words[$i] & 0xFFFFFFFF, 0);
    }
    @c = cw(3, 0, 0, 0); iw($c[0], $c[1], 0);
    @c = cw(4, $TILE_CPU_RB_BASE, 4, 0); iw($c[0], $c[1], 0);
    @c = cw(5, 0, 0, 0); iw($c[0], $c[1], 0);
    id();
    my $done = pt(100, 50);   # up to 5s per tile (compute is ~1ms)
    if (!$done) {
        printf("  [TILE %2d] TIMEOUT (entry_pc=%d)\n", $tile_idx, $entry_pc);
        return 0;
    }
    return 1;
}

# Final D_PACK: drain Y from GPU DMEM[X3_BASE..] to CPU DMEM, then READBACK + SEND.
sub final_readback {
    # D_PACK ARM into CPU IMEM (overwrites tile ARM)
    my $arm = build_dpack_arm();
    ic();
    pkt_load_imem(0, $arm, 0, scalar(@$arm), 0x20);
    id();

    my $rb_base     = $TILE_CPU_RB_BASE;       # 16
    my $wait_target = $rb_base + 8;             # 24 (2 words/bank × 4 banks)

    # Stage D_PACK params at CPU DMEM[0..3]:
    #   word 0 = GPU X3_BASE (src)
    #   word 1 = rb_base     (dst)
    #   word 2 = wait_target
    #   word 3 = 0
    # iw(hi, lo) packs { HI:word[i+1], LO:word[i] } per DW, so
    # first DW:  HI=rb_base,    LO=X3_BASE
    # second DW: HI=0,          LO=wait_target
    ic();
    my @c;
    @c = cw(2, 0, 2, 0); iw($c[0], $c[1], 0x20);
    iw($rb_base,     $ANN_HW_GPU_X3_BASE, 0);
    iw(0,            $wait_target,         0);

    @c = cw(3, 0,         0, 0); iw($c[0], $c[1], 0);   # CPU_START
    @c = cw(4, $rb_base,  4, 0); iw($c[0], $c[1], 0);   # READBACK 4 DWs from RB area
    @c = cw(5, 0,         0, 0); iw($c[0], $c[1], 0);   # SEND_PKT
    id();
    my $done = pt(300, 100);
    my @tx = cr();
    return ($done, @tx);
}

# ══════════════════════════════════════════════════════════════
#  Diagnostic subcommands — bisect where the tile loop wedges
# ══════════════════════════════════════════════════════════════

# Build ARM programs of increasing ambition.
# Each returns a ref to a 32b word array.
sub build_halt_only_arm {
    my @p;
    push @p, $HALT;                          # 0: HALT
    push @p, $HALT;                          # 1: HALT (2-sighting stability filter)
    return \@p;
}

sub build_dma_only_arm {
    # Same D_UNPACK + wait as the real tile_arm, but NO GPU kick.
    my @p;
    push @p, arm_mov_imm(0, 0);
    push @p, arm_mov_imm(1, 0);
    push @p, arm_mcr(1, 0);                   # CR0 = 0 (src)
    push @p, arm_ldr_imm(1, 0, $TILE_CPU_GPU_PBASE * 4);  # R1 = mem[12]
    push @p, arm_mcr(1, 1);                   # CR1 = GPU_PARAM_BASE (dst)
    push @p, arm_mov_imm(1, 3);
    push @p, arm_mcr(1, 2);                   # CR2 = 3 (len)
    push @p, arm_mov_imm(1, 0x41);
    push @p, arm_mcr(1, 3);                   # CR3 = 0x41 kick D_UNPACK
    my $wait = scalar @p;
    push @p, arm_mrc(5, 9);
    push @p, arm_ldr_imm(6, 0, $TILE_CPU_WAIT_DMA * 4);
    push @p, arm_cmp_reg(5, 6);
    push @p, arm_b_idx(0x1, scalar(@p), $wait);
    push @p, $HALT;
    push @p, $HALT;
    return \@p;
}

# Run one packet with a given ARM installed + one tile param block staged.
sub diag_pkt {
    my ($label, $arm_ref, $entry_pc_stub) = @_;

    ic();
    pkt_load_imem(0, $arm_ref, 0, scalar(@$arm_ref), 0x20);
    id();

    # Stage the same param block tile 0 would see (L1 ReLU tile), so
    # if the diagnostic ARM does use them, values are sensible.
    my $rec = $ANN_HW_SCHED_CPU_BASE;   # tile 0 sched record start
    my @words;
    for my $bank (0..3) {
        for my $i (0..2) {
            push @words, $final_dmem[$rec + 1 + $bank*3 + $i];
        }
    }
    push @words, $ANN_HW_GPU_PARAM_BASE;
    push @words, defined($entry_pc_stub) ? $entry_pc_stub : $final_dmem[$rec + 0];
    push @words, 12;
    push @words, 5;

    ic();
    my @c;
    @c = cw(2, 0, 8, 0); iw($c[0], $c[1], 0x20);
    for (my $i = 0; $i < 16; $i += 2) {
        iw($words[$i+1] & 0xFFFFFFFF, $words[$i] & 0xFFFFFFFF, 0);
    }
    @c = cw(3, 0, 0, 0); iw($c[0], $c[1], 0);
    @c = cw(4, $TILE_CPU_RB_BASE, 4, 0); iw($c[0], $c[1], 0);
    @c = cw(5, 0, 0, 0); iw($c[0], $c[1], 0);
    id();
    my $done = pt(60, 50);     # 3 s timeout
    dump_st("diag-post");
    if ($done) {
        my @tx = cr();
        printf("  [%s] PASS — txd fired, TX[0]={%08X,%08X}\n",
            $label, $tx[0], $tx[1]);
        $pass++;
    } else {
        printf("  [%s] TIMEOUT — pkt_proc wedged (likely P_CPU_RUN, cpu_done never asserted)\n",
            $label);
        $fail++;
    }
}

sub ann_diag {
    banner("T_ANN_DIAG: bisect CPU/DMA/GPU host-driven tile path");
    ann_build_host();
    hard_reset();

    phase("(1/4) HALT-only ARM — checks CPU reset/start/halt round-trip");
    diag_pkt("DIAG-HALT", build_halt_only_arm(), 0);

    phase("(2/4) DMA-only ARM — adds D_UNPACK+wait (no GPU kick)");
    diag_pkt("DIAG-DMA", build_dma_only_arm(), 0);

    phase("(3/4) Full tile ARM — adds GPU launch+wait (what `run` uses)");
    diag_pkt("DIAG-FULL", build_tile_arm(), $ANN_HW_GPU_RELU_PC);

    phase("(4/4) K-loop WMMA — multi-iteration BF16 chain accumulator");
    probe_k_scenarios();
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_K: WMMA chain accumulator across K iterations
#  (same pattern the scheduler uses for L1/L2/L3 K-loops)
#
#  Per-iteration: LOAD.A, LOAD.B (new base), MMA → D accumulates.
#  First iteration also does LOAD.C (initial value), last iteration
#  is followed by STORE and RET.  With A = B = 1.0 and C = 0, the
#  exact BF16 answer per lane is 4·K (integer, no rounding).
#
#  If K=1 passes but K>1 fails, the bug is in BF16 chain-accum —
#  the exact pattern we'd need to explain the full-ANN drift.
# ══════════════════════════════════════════════════════════════
sub run_probe_k_tile {
    my ($K) = @_;       # K = number of WMMA.MMA chain iterations
    hard_reset();

    # GPU DMEM layout (per bank): A at [0..4K-1], B at [4K..8K-1],
    # C at [8K..8K+3], D at [8K+4..8K+7].
    my $A_BASE = 0;
    my $B_BASE = 4 * $K;
    my $C_BASE = 8 * $K;
    my $D_BASE = 8 * $K + 4;

    # ── GPU program (unrolled K-iteration accumulator) ──
    my @gp;
    for my $k (0 .. $K - 1) {
        push @gp, enc_movi_dt(0, 0, $A_BASE + 4 * $k);
        push @gp, enc_wmma_load(0, 4, 0, 0);
        push @gp, enc_movi_dt(0, 0, $B_BASE + 4 * $k);
        push @gp, enc_wmma_load(1, 8, 0, 0);
        if ($k == 0) {
            push @gp, enc_movi_dt(0, 0, $C_BASE);
            push @gp, enc_wmma_load(2, 12, 0, 0);
        }
        push @gp, enc_wmma_mma(12, 4, 8, 12);
    }
    push @gp, enc_movi_dt(0, 0, $D_BASE);
    push @gp, enc_wmma_store(12, 0, 0);
    push @gp, (($OP_RET & 0x1F) << 27);
    push @gp, 0 while @gp % 2;

    # ── CPU DMEM payload: GPU prog then 4 × (A, B, C) per-bank ──
    # Per bank = 2K DWs A + 2K DWs B + 2 DWs C = 4K+2 DWs.
    my $xfer_per_bank = 4 * $K + 2;
    my @dmem;
    push @dmem, $_ for @gp;
    my $ONES_DW = (0x3F80 << 16) | 0x3F80;    # two BF16 1.0
    for my $bank (0..3) {
        push @dmem, $ONES_DW for 1 .. 2 * $K;   # A: all 1.0
        push @dmem, $ONES_DW for 1 .. 2 * $K;   # B: all 1.0
        push @dmem, 0, 0;                        # C: all 0.0
    }
    push @dmem, 0 for 1..8;                      # pack dest zero-pad

    # ── ARM program (CR10 TID gate + D_IMEM + D_UNPACK + launch + D_PACK) ──
    my @arm;
    push @arm, arm_mrc(11, 10);
    push @arm, arm_cmp_imm(11, 0);
    push @arm, 0;                                 # patched B.NE → halt
    push @arm, arm_mov_imm(0, 0);
    push @arm, arm_mcr(0, 0);
    push @arm, arm_mcr(0, 1);
    push @arm, arm_mov_imm(1, scalar(@gp));
    push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(2, 5);
    push @arm, arm_mcr(2, 3);
    my $wait_imem = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, scalar(@gp));
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_imem);

    push @arm, arm_mov_imm(1, scalar(@gp));
    push @arm, arm_mcr(1, 0);
    push @arm, arm_mov_imm(1, 0);
    push @arm, arm_mcr(1, 1);
    push @arm, arm_mov_imm(1, $xfer_per_bank);
    push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(1, 0x41);
    push @arm, arm_mcr(1, 3);
    my $wait_unpack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, scalar(@gp) + 4 * $xfer_per_bank);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_unpack);

    push @arm, arm_mov_imm(1, 0);  push @arm, arm_mcr(1, 4);
    push @arm, arm_mov_imm(1, 15); push @arm, arm_mcr(1, 7);
    push @arm, arm_mov_imm(1, 1);  push @arm, arm_mcr(1, 5);
    my $wait_gpu = scalar @arm;
    push @arm, arm_mrc(3, 6);
    push @arm, arm_mov_imm(4, 5);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_gpu);

    my $rb_cpu_base = scalar(@gp) + 4 * $xfer_per_bank;
    push @arm, arm_mov_imm(1, $D_BASE);     push @arm, arm_mcr(1, 0);
    push @arm, arm_mov_imm(1, $rb_cpu_base); push @arm, arm_mcr(1, 1);
    push @arm, arm_mov_imm(1, 2);            push @arm, arm_mcr(1, 2);
    push @arm, arm_mov_imm(1, 0x43);         push @arm, arm_mcr(1, 3);
    my $wait_pack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, $rb_cpu_base + 8);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_pack);
    push @arm, $HALT; push @arm, $HALT;
    my $arm_len = scalar @arm;
    $arm[2] = arm_b_idx(0x1, 2, $arm_len - 2);
    push @arm, $NOP if $arm_len % 2;

    # ── Push IMEM + DMEM (chunked — avoids MMIO scratch overflow) ──
    # Inline all-in-one-packet works for K=1,2 but at K≥5 the combined
    # IMEM+DMEM+3 control cmds exceeds the ~64-DW scratch buffer and
    # pkt_proc corrupts (K=5 shows junk, K=10+ shows zeros).  Match the
    # real `run` path by chunking each LOAD_IMEM / LOAD_DMEM / final-cmd
    # into separate ic()/id() packets.
    send_imem_chunked(0, \@arm,  sprintf("probe_k_arm K=%d",  $K));
    send_dmem_chunked(0, \@dmem, sprintf("probe_k_dmem K=%d", $K));

    # Final packet: CPU_START + READBACK + SEND_PKT
    ic();
    my @c_cmd;
    @c_cmd = cw(3, 0, 0, 0);            iw($c_cmd[0], $c_cmd[1], 0x20);
    @c_cmd = cw(4, $rb_cpu_base, 4, 0); iw($c_cmd[0], $c_cmd[1], 0);
    @c_cmd = cw(5, 0, 0, 0);            iw($c_cmd[0], $c_cmd[1], 0);
    id();
    my $done = pt(600, 50);
    return (0,0,0,0) unless $done;
    return cr();
}

# Drives probe_k across several K values.  Expected D per lane = 4*K (integer).
# K values chosen to exercise the scheduler's real K_count: L1=10, L3=11.
# (L2=24 would need a multi-byte ARM immediate — skipped here; 10 & 11 together
#  give strong evidence that the K-loop works for scheduler-sized chains.)
sub probe_k_scenarios {
    my @scenarios = (
        [1,  0x4080, 4.0],      # baseline: identical to single-tile S1
        [2,  0x4100, 8.0],
        [5,  0x41A0, 20.0],
        [10, 0x4220, 40.0],     # L1 K_count
        [11, 0x4230, 44.0],     # L3 K_count
    );
    for my $sc (@scenarios) {
        my ($K, $exp_hex, $exp_dec) = @$sc;
        my @tx = run_probe_k_tile($K);
        my ($g_hex, $g_dec) = decode_pkt($tx[0], $tx[1]);
        my $all_ok = 1;
        for my $j (0..3) { $all_ok = 0 if $g_hex->[$j] != $exp_hex; }
        my $ok = $all_ok ? "[PASS]" : "[FAIL]";
        printf("  %s K=%2d  exp=%04X (%.2f)  got_lanes = %04X %04X %04X %04X  (%.3f %.3f %.3f %.3f)\n",
            $ok, $K, $exp_hex, $exp_dec,
            $g_hex->[0], $g_hex->[1], $g_hex->[2], $g_hex->[3],
            $g_dec->[0], $g_dec->[1], $g_dec->[2], $g_dec->[3]);
        if ($all_ok) { $pass++ } else { $fail++ }
    }
    print "\n  [NOTE] K=1 replicates the single-tile probe; K=10 and K=11 hit the\n";
    print "         exact chain-length the scheduler uses for L1 and L3 layers.\n";
    print "         If K=1 passes but K>1 fails → BF16 chain-accum bug in the\n";
    print "         tensor core (would cascade into the full ANN).\n";
}

sub ann_probe_k {
    banner("T_PROBE_K: multi-iteration K-loop WMMA accumulator");
    probe_k_scenarios();
}

# Stage 2: on-SoC scheduler flow — mirrors model_tb T5 ("HW scheduler").
# Assumes GPU DMEM already holds weights (from a prior `load` run).
# The scheduler program itself runs the 36-tile outer loop; the host just
# pushes the scheduler program + final_dmem image, kicks CPU_START, and
# reads back the four logit packets.  Thread 0 is gated-in via CR10 MRC.
sub ann_run_inference {
    my ($mode) = @_;
    my $old_mode = $input_mode;
    $input_mode = $mode if defined $mode;
    my $is_class_demo = ($input_mode eq "classes");

    banner($is_class_demo
        ? "T_ANN_CLASSES: one real sample for each trained class"
        : "T_ANN_RUN: on-SoC scheduler (36-tile, CR10 TID gate)");
    ann_build_host();
    hard_reset();

    phase("CPU IMEM ← scheduler program");
    send_imem_chunked(0, \@sched_prog, "sched_prog");

    phase("CPU DMEM ← final image (params + GPU prog + input + sched records)");
    send_dmem_chunked(0, [ @final_dmem[0 .. $final_dmem_words - 1] ], "final_dmem");

    phase("CPU_START + READBACK + SEND_PKT");
    ic();
    my @c;
    @c = cw(3, 0, 0, 0);                                    iw($c[0], $c[1], 0x2B);
    @c = cw(4, $ANN_HW_READBACK_CPU_BASE, 4, 0);            iw($c[0], $c[1], 0x00);
    @c = cw(5, 0, 0, 0);                                    iw($c[0], $c[1], 0x00);
    id();
    my $done = pt(1200, 100);    # ~120s budget (sim runs in ~77k cycles)
    dump_st("post-poll");
    my @tx = cr();
    if ($is_class_demo) {
        verify_tx_classes($done, @tx);
    } else {
        verify_tx($done, @tx);
    }
    $input_mode = $old_mode;
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_W: spot-check weights in GPU DMEM after `load`
#
#  Uses D_PACK to read {2 BF16 per bank × 4 banks = 8 BF16 total} at a
#  specified GPU DMEM address.  Compares each bank's readback against
#  the host-side reference image built by build_gpu_image() (pack_l1/
#  l2/l3).  A mismatch on ANY spot proves the copy_prog upload path
#  is corrupting weights.
#
#  Does NOT reload weights — assumes `sw/model_test load` already ran.
#  GPU DMEM is BRAM, survives hard_reset().
# ══════════════════════════════════════════════════════════════
sub run_pack_probe {
    my ($gpu_src) = @_;
    hard_reset();

    # Minimal ARM: CR10 gate → D_PACK(GPU[gpu_src], xfer_len=1/bank) → CPU[0..3]
    my @arm;
    push @arm, arm_mrc(11, 10);
    push @arm, arm_cmp_imm(11, 0);
    push @arm, 0;                                    # patched B.NE → halt
    # arm_mov_imm only encodes 8b immediates; for gpu_src ≥ 256 we build the
    # 16b value via low-byte MOV + high-byte MOV + LSL-8 ORR.
    push @arm, arm_mov_imm(1, $gpu_src & 0xFF);
    if ($gpu_src >= 256) {
        push @arm, arm_mov_imm(2, ($gpu_src >> 8) & 0xFF);
        push @arm, arm_orr_shift(1, 1, 2, $SHIFT_LSL, 8);
    }
    push @arm, arm_mcr(1, 0);                         # CR0 = GPU src
    push @arm, arm_mov_imm(1, 0);       push @arm, arm_mcr(1, 1);   # CR1 = CPU dst = 0
    push @arm, arm_mov_imm(1, 1);       push @arm, arm_mcr(1, 2);   # CR2 = xfer_len/bank
    push @arm, arm_mov_imm(1, 0x43);    push @arm, arm_mcr(1, 3);   # CR3 = D_PACK burst_all
    # Wait: CR9 advances by 1 per 32b word written → target = 4 (4 banks × 1 DW)
    my $wait_pack = scalar @arm;
    push @arm, arm_mrc(3, 9);
    push @arm, arm_mov_imm(4, 4);
    push @arm, arm_cmp_reg(3, 4);
    push @arm, arm_b_idx(0x1, scalar(@arm), $wait_pack);
    push @arm, $HALT; push @arm, $HALT;
    my $arm_len = scalar @arm;
    $arm[2] = arm_b_idx(0x1, 2, $arm_len - 2);
    push @arm, $NOP if $arm_len % 2;

    send_imem_chunked(0, \@arm, "pack_probe_arm");

    ic();
    my @c_cmd;
    @c_cmd = cw(3, 0, 0, 0); iw($c_cmd[0], $c_cmd[1], 0x20);
    @c_cmd = cw(4, 0, 4, 0); iw($c_cmd[0], $c_cmd[1], 0);
    @c_cmd = cw(5, 0, 0, 0); iw($c_cmd[0], $c_cmd[1], 0);
    id();
    my $done = pt(200, 50);
    return (0,0,0,0) unless $done;
    return cr();
}

# Run one spot-check and report.  @tx layout after D_PACK(xfer_len=1,burst_all):
#   CPU DMEM[0] = bank0's packed DW → TX[0] lo32
#   CPU DMEM[1] = bank1's packed DW → TX[0] hi32
#   CPU DMEM[2] = bank2's packed DW → TX[1] lo32
#   CPU DMEM[3] = bank3's packed DW → TX[1] hi32
# Each bank's DW = (GPU[gpu_src+1] << 16) | GPU[gpu_src].
sub probe_weights_spot {
    my ($gpu_src, $label) = @_;
    my @tx = run_pack_probe($gpu_src);
    # tx = [W0H, W0L, W1H, W1L]; TX0 64-bit = (W0H<<32)|W0L; TX1 = (W1H<<32)|W1L
    my @got;
    push @got, $tx[1]        & 0xFFFF;   # bank0 BF16 lo
    push @got, ($tx[1] >> 16) & 0xFFFF;  # bank0 BF16 hi
    push @got, $tx[0]        & 0xFFFF;   # bank1 BF16 lo
    push @got, ($tx[0] >> 16) & 0xFFFF;  # bank1 BF16 hi
    push @got, $tx[3]        & 0xFFFF;   # bank2 BF16 lo
    push @got, ($tx[3] >> 16) & 0xFFFF;  # bank2 BF16 hi
    push @got, $tx[2]        & 0xFFFF;   # bank3 BF16 lo
    push @got, ($tx[2] >> 16) & 0xFFFF;  # bank3 BF16 hi

    my @exp;
    for my $bank (0..3) {
        push @exp, gpu_bank_read($bank, $gpu_src + 0),
                   gpu_bank_read($bank, $gpu_src + 1);
    }
    my $all_ok = 1;
    for my $i (0..7) { $all_ok = 0 if $got[$i] != $exp[$i]; }
    my $ok = $all_ok ? "[PASS]" : "[FAIL]";
    printf("  %s %s  GPU[%d..%d]\n", $ok, $label, $gpu_src, $gpu_src+1);
    for my $bank (0..3) {
        my $g0 = $got[$bank*2];   my $g1 = $got[$bank*2+1];
        my $e0 = $exp[$bank*2];   my $e1 = $exp[$bank*2+1];
        my $mark = ($g0 == $e0 && $g1 == $e1) ? "   " : " ! ";
        printf("      %s bank%d  got %04X %04X  exp %04X %04X   (%.4g %.4g vs %.4g %.4g)\n",
            $mark, $bank, $g0, $g1, $e0, $e1,
            bf16_to_f($g0), bf16_to_f($g1),
            bf16_to_f($e0), bf16_to_f($e1));
    }
    if ($all_ok) { $pass++ } else { $fail++ }
}

sub ann_probe_weights {
    banner("T_PROBE_W: GPU DMEM weight image spot-check (post-load)");
    print "  Reads GPU DMEM via D_PACK, compares with host pack_l1/l2/l3 image.\n";
    print "  Requires `sw/model_test load` to have run already (BRAM persists).\n";
    print "  A mismatch ANYWHERE ⇒ copy_prog upload path is corrupting weights.\n\n";

    ann_build_host();    # populates host gpu_bank[] reference

    # Spot-check boundaries + mid-points of each region.
    # PRELOAD0 covers GPU[0..2039]/bank, PRELOAD1 covers [2040..2203]/bank.
    probe_weights_spot($ANN_HW_GPU_W1_BASE,        "L1-W start  (tile0)     ");
    probe_weights_spot($ANN_HW_GPU_W1_BASE + 480,  "L1-W mid    (ot=12)     ");
    probe_weights_spot($ANN_HW_GPU_W1_BASE + 956,  "L1-W end    (ot=23,k=9) ");
    probe_weights_spot($ANN_HW_GPU_B1_BASE,        "L1-B start              ");
    probe_weights_spot($ANN_HW_GPU_W2_BASE,        "L2-W start              ");
    probe_weights_spot($ANN_HW_GPU_W2_BASE + 1000, "L2-W deep   (spans P0/P1)");
    probe_weights_spot($ANN_HW_GPU_B2_BASE,        "L2-B (PRELOAD1)         ");
    probe_weights_spot($ANN_HW_GPU_W3_BASE,        "L3-W (PRELOAD1)         ");
    probe_weights_spot($ANN_HW_GPU_B3_BASE,        "L3-B (PRELOAD1)         ");
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_L: CPU DMEM layout verification (post-upload, pre-execute)
#
#  Uploads the exact final_dmem image `run` sends, then uses READBACK
#  + SEND_PKT to read 4 CPU DMEM DWs at strategic addresses.  Compares
#  each against the host-side @final_dmem[].
#
#  This tests two remaining hypotheses from the per-packet drift:
#   (A) Input staging  — does the 80-DW input block at INPUT_CPU_BASE
#       contain the exact bank-striped pattern the scheduler expects?
#   (B) Sched records  — do the 36 records at SCHED_CPU_BASE encode
#       the (a_base, b_base, c_base, k_count, out_base) values the
#       scheduler will read for L1, L2, L3 tiles?
#
#  Sched records are read from the perspective of bank0 (first entry
#  after the record's entry_pc).  If bank0's record is right, the
#  remaining banks' records are built by the same write_sched_record
#  loop so they match too.
# ══════════════════════════════════════════════════════════════
sub probe_layout_spot {
    my ($addr, $label) = @_;
    ic();
    my @c = cw(4, $addr, 4, 0); iw($c[0], $c[1], 0x20);
    @c = cw(5, 0, 0, 0);         iw($c[0], $c[1], 0);
    id();
    my $done = pt(200, 50);
    unless ($done) {
        printf("  [FAIL] %s  READBACK timeout\n", $label);
        $fail++;
        return;
    }
    my @tx = cr();
    # TX snoop: tx[0]=W0H, tx[1]=W0L, tx[2]=W1H, tx[3]=W1L.
    # Each 64b TX word packs 2 CPU DWs: CPU[addr]=W0L, CPU[addr+1]=W0H,
    # CPU[addr+2]=W1L, CPU[addr+3]=W1H.
    my @got = ($tx[1] & 0xFFFFFFFF, $tx[0] & 0xFFFFFFFF,
               $tx[3] & 0xFFFFFFFF, $tx[2] & 0xFFFFFFFF);
    my @exp = map { $final_dmem[$_] & 0xFFFFFFFF } ($addr..$addr+3);
    my $all_ok = 1;
    for my $i (0..3) { $all_ok = 0 if $got[$i] != $exp[$i]; }
    my $ok = $all_ok ? "[PASS]" : "[FAIL]";
    printf("  %s %s  CPU[%d..%d]\n", $ok, $label, $addr, $addr+3);
    for my $i (0..3) {
        my $mark = ($got[$i] == $exp[$i]) ? "   " : " ! ";
        printf("      %s DW[%d]  got %08X  exp %08X  (lo16=%04X hi16=%04X  vs  lo16=%04X hi16=%04X)\n",
            $mark, $addr + $i, $got[$i], $exp[$i],
            $got[$i] & 0xFFFF, ($got[$i] >> 16) & 0xFFFF,
            $exp[$i] & 0xFFFF, ($exp[$i] >> 16) & 0xFFFF);
    }
    if ($all_ok) { $pass++ } else { $fail++ }
}

sub ann_probe_layout {
    banner("T_PROBE_L: CPU DMEM layout verify (input + sched records)");
    print "  Uploads final_dmem (same as `run`), then READBACKs strategic\n";
    print "  addresses and compares against the host image.  Any mismatch ⇒\n";
    print "  the scheduler is reading wrong values for that slot.\n\n";

    ann_build_host();
    hard_reset();

    # Same upload the `run` command does — identical chunking.
    send_dmem_chunked(0, [@final_dmem[0..$final_dmem_words-1]], "final_dmem");

    my $S  = $ANN_HW_SCHED_CPU_BASE;
    my $RW = $ANN_HW_SCHED_RECORD_WORDS;   # 13

    my @spots = (
        # Header fields the scheduler reads via LDR [R0, #byte_off]
        [0,                            "Header  [0..3]    (WAIT_PARAM/INPUT/GPU + GPUK_BASE)"],
        [12,                           "Header  [12..15]  (PARAM_BASE + X0 + X3 + gpu_prog_len)"],
        # Input staging — one check per bank's region
        [$ANN_HW_INPUT_CPU_BASE,       "Input   bank0 start    (flat_idx 0..3)"],
        [$ANN_HW_INPUT_CPU_BASE + 20,  "Input   bank1 start    (flat_idx 20..23)"],
        [$ANN_HW_INPUT_CPU_BASE + 40,  "Input   bank2 start    (flat_idx 40..43)"],
        [$ANN_HW_INPUT_CPU_BASE + 60,  "Input   bank3 start    (flat_idx 60..63)"],
        # Sched records — first/last of each layer
        [$S + 0 * $RW,                 "SchedR[0]   L1 tile 0    (entry_pc + bank0 a/b/c)"],
        [$S + 12 * $RW,                "SchedR[12]  L1 tile 12   (mid L1)"],
        [$S + 23 * $RW,                "SchedR[23]  L1 tile 23   (last L1)"],
        [$S + 24 * $RW,                "SchedR[24]  L2 tile 0    (first L2)"],
        [$S + 34 * $RW,                "SchedR[34]  L2 tile 10   (last L2)"],
        [$S + 35 * $RW,                "SchedR[35]  L3 tile      (only L3)"],
    );

    for my $spot (@spots) {
        probe_layout_spot(@$spot);
    }
}

# ══════════════════════════════════════════════════════════════
#  T_PROBE_X1/X2/X3: HW activations in GPU DMEM vs IP RTL reference
#
#  After `sw/model_test run` completes, intermediate activations live
#  at GPU[X1_BASE..+95], GPU[X2_BASE..+167], GPU[X3_BASE..+15] per
#  bank (bank b owns neurons {b, b+4, b+8, …}).  We read them back via
#  D_PACK and compare against IP-exact ann_ref_l[123]_act arrays below.
#
#  Splits the drift bug cleanly:
#    · L1 bit-exact  ⇒ drift begins in L2/L3 (much narrower search)
#    · L1 drifts     ⇒ L1 MAC with real BF16 data diverges from reference
#
#  The reference arrays are hardcoded from the CoreGen-backed RTL dump in
#  Final/model/ann_ref_l[123]_act.hex.  To regenerate: recompile/run
#  Final/src/sim/model_tb_ip.vvp after changing the arithmetic or weights,
#  then re-hardcode from the hex.
# ══════════════════════════════════════════════════════════════

