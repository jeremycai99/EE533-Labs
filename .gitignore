# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# MacOS garbage
.DS_Store

# Python cache
__pycache__/

# Generated model artifacts.  Only the 4 canonical per-thread BF16 weight
# hex files (ann_weights_dmem_t[0-3].hex) are committed — everything else
# that training emits (scaler_*.npy, feat_idx.npy, ann_weights_bf16.npy,
# config.txt, raw intermediate hex) stays out of git.
Final/model/*.npy
Final/model/ann_config.txt
Final/model/ann_hw_compat_info.txt
Final/model/ann_weights_raw_dmem_t*.hex
Final/model/top32_feat_idx.npy
Final/model/lgbm_top32_feat_idx.npy

# Sim-generated activation reference dumps (regenerate by re-running sim).
Final/model/ann_ref_l1_act.hex
Final/model/ann_ref_l2_act.hex
Final/model/ann_ref_l3_act.hex

# Local training datasets
Final/model/iec104_train_test/
Final/model/iec104_train_test_csvs

# ignore large .vcd files
*.vcd
